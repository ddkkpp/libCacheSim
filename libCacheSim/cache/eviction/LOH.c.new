static void LOH_print_cache(const cache_t *cache);

// Define the IRT (Inter-Request Time) history data structure
#define IRT_HISTORY_SIZE 3
#define MAX_CANDIDATES 60  // Maximum size of eviction candidate pool
#define FEATURE_DIM 6      // Number of features for scoring
#define CONTEXT_DIM 14     // Number of context dimensions for learning
#define SHM_KEY 9876       // Key for shared memory segment
#define SEM_KEY 9877       // Key for semaphore

// Structure shared between C and Python for Actor-Critic network
typedef struct {
  // Control flags
  int ready_for_inference;  // Set to 1 when state is ready for inference
  int weights_updated;      // Set to 1 when weights have been updated by Python
  int terminate;            // Set to 1 to signal termination

  // State information - 14-dimensional state vector
  double state[CONTEXT_DIM];

  // Feature weights for policy network output (6 dimensions)
  double weights[FEATURE_DIM];

  // Performance metrics for reward calculation
  double miss_ratio;       // Current miss ratio
  double byte_miss_ratio;  // Current byte miss ratio
  double reward;           // Current reward value

  // Timestamp for synchronization
  int64_t timestamp;
} shm_data_t;
#define STATS_WINDOW 10000   // Window size for tracking stats
#define FREQ_MAX 255         // Maximum frequency to track individually
#define SIZE_BUCKET_COUNT 5  // Number of size buckets (only 512KB and above)

// Define the object metadata for LOH
// Using the pre-declared LOH_obj_metadata_t from cacheObj.h

// IRT min-heap entry
typedef struct {
  cache_obj_t *obj;   // Pointer to the cache object
  int64_t irt_value;  // The IRT value this heap is tracking
} irt_heap_entry_t;

// Frequency table node for linked list
typedef struct loh_freq_node {
  cache_obj_t *obj;            // Pointer to the cache object
  struct loh_freq_node *prev;  // Previous node in the frequency list
  struct loh_freq_node *next;  // Next node in the frequency list
} loh_freq_node_t;

// Size bucket node for linked list
typedef struct size_node {
  cache_obj_t *obj;        // Pointer to the cache object
  struct size_node *prev;  // Previous node in the size bucket
  struct size_node *next;  // Next node in the size bucket
} size_node_t;

// Structure to track feature statistics for hit/miss objects
typedef struct {
  double hit_recency_sum;
  double hit_frequency_sum;
  double hit_size_sum;
  double hit_irt1_sum;
  double hit_irt2_sum;
  double hit_irt3_sum;

  double miss_recency_sum;
  double miss_frequency_sum;
  double miss_size_sum;
  double miss_irt1_sum;
  double miss_irt2_sum;
  double miss_irt3_sum;

  int hit_count;
  int miss_count;
} feature_stats_t;

// Define the LOH parameters structure
typedef struct {
  // Reference to the parent cache
  void *cache_ptr;  // Pointer to the parent cache_t structure

  // LRU队列 - 跟踪最近性
  cache_obj_t *q_head;        // Queue head for maintaining object order
  cache_obj_t *q_tail;        // Queue tail for maintaining object order
  int64_t current_timestamp;  // Current logical timestamp

  // 频率表 - 跟踪访问频率
  loh_freq_node_t *freq_table[FREQ_MAX + 1];       // Array of frequency lists
  loh_freq_node_t *freq_table_tail[FREQ_MAX + 1];  // Tails of frequency lists

  // IRT堆 - 跟踪访问间隔时间
  irt_heap_entry_t *irt_heap[IRT_HISTORY_SIZE];  // Three separate min-heaps for
                                                 // each IRT value
  int irt_heap_size[IRT_HISTORY_SIZE];  // Current number of elements in each
                                        // heap
  int irt_heap_capacity;                // Maximum capacity of each heap

  // 尺寸桶 - 跟踪对象尺寸
  size_node_t *size_buckets[SIZE_BUCKET_COUNT];  // Bucket heads for different
                                                 // size ranges
  size_node_t *size_buckets_tail[SIZE_BUCKET_COUNT];  // Bucket tails
  int64_t
      size_bucket_bounds[SIZE_BUCKET_COUNT];  // Upper bounds for each bucket

  // 特征哈希表 - 快速查找频率节点和尺寸节点
  GHashTable *freq_node_map;  // 对象到频率节点的映射
  GHashTable *size_node_map;  // 对象到尺寸节点的映射

  // Feature weights for scoring function
  double weights[FEATURE_DIM];

  // Candidate objects for eviction
  cache_obj_t *candidates[MAX_CANDIDATES];
  int n_candidates;

  // Statistics for learning
  feature_stats_t recent_stats;
  double recent_obj_hit_ratio;
  double recent_byte_hit_ratio;
  int64_t recent_hits;
  int64_t recent_misses;
  int64_t recent_hit_bytes;
  int64_t recent_miss_bytes;

  // Actor-Critic RL shared memory structures
  int shm_id;     // Shared memory segment ID
  void *shm_ptr;  // Pointer to shared memory
  int sem_id;     // Semaphore ID for synchronization

  // 14-dimensional context state vector
  double context_state[CONTEXT_DIM];  // Input to Actor-Critic networks

  // RL training parameters
  int64_t rl_update_interval;  // How often to update state and weights
  int64_t requests_since_rl_update;
  double epoch_start_time;      // Start time of current training epoch
  double epoch_obj_miss_count;  // For calculating epoch miss ratio
  double epoch_obj_count;
  double epoch_byte_miss_count;  // For calculating epoch byte miss ratio
  double epoch_byte_count;

  // Learning parameters
  int64_t learning_interval;  // How often to update weights
  int64_t requests_since_update;

  // Min-max values for feature normalization
  double min_values[FEATURE_DIM];
  double max_values[FEATURE_DIM];

  // Flag to indicate if the cache has been "warmed up"
  bool is_warmed_up;
} LOH_params_t;

// Actor-Critic related functions
// Semaphore operations for synchronization
static void lock_shared_memory(LOH_params_t *params) {
  if (params->sem_id == -1) return;

  struct sembuf sb;
  sb.sem_num = 0;
  sb.sem_op = -1;  // Decrement by 1 (acquire)
  sb.sem_flg = SEM_UNDO;

  if (semop(params->sem_id, &sb, 1) == -1) {
    perror("semop lock failed");
  }
}

static void unlock_shared_memory(LOH_params_t *params) {
  if (params->sem_id == -1) return;

  struct sembuf sb;
  sb.sem_num = 0;
  sb.sem_op = 1;  // Increment by 1 (release)
  sb.sem_flg = SEM_UNDO;

  if (semop(params->sem_id, &sb, 1) == -1) {
    perror("semop unlock failed");
  }
}

// Update state vector for Actor-Critic network
static void update_state_vector(LOH_params_t *params) {
  // Calculate miss ratios
  double obj_miss_ratio = 0.0;
  if (params->epoch_obj_count > 0) {
    obj_miss_ratio = params->epoch_obj_miss_count / params->epoch_obj_count;
  }

  double byte_miss_ratio = 0.0;
  if (params->epoch_byte_count > 0) {
    byte_miss_ratio = params->epoch_byte_miss_count / params->epoch_byte_count;
  }

  // Calculate epoch duration
  double epoch_duration = time(NULL) - params->epoch_start_time;
  if (epoch_duration < 1.0) epoch_duration = 1.0;

  // Update context state vector (14 dimensions)
  params->context_state[0] = obj_miss_ratio;
  params->context_state[1] = byte_miss_ratio;
  params->context_state[2] =
      params->epoch_obj_count / epoch_duration;  // Request rate
  params->context_state[3] =
      params->epoch_byte_count / epoch_duration;  // Data rate

  // Feature weights (6 dimensions)
  for (int i = 0; i < FEATURE_DIM; i++) {
    params->context_state[i + 4] = params->weights[i];
  }

  // System metrics (4 dimensions) - could include:
  // - Current cache size utilization
  // - Average object size
  // - Working set size estimate
  // - Temporal locality measure
  cache_t *cache = (cache_t *)params->cache_ptr;
  params->context_state[10] = (double)cache_get_occupied_byte_default(cache) /
                              (double)cache->cache_size;  // Cache utilization

  // These would need proper implementation based on your metrics
  params->context_state[11] = 0.0;  // Average object size or other metric
  params->context_state[12] = 0.0;  // Working set estimate
  params->context_state[13] = 0.0;  // Temporal locality measure
}

// Send state to Actor-Critic network and get updated weights
static void sync_with_actor_critic(LOH_params_t *params) {
  if (params->shm_ptr == NULL) return;

  // Calculate current state vector
  update_state_vector(params);

  // Acquire lock on shared memory
  lock_shared_memory(params);

  // Update shared memory with current state
  shm_data_t *shm_data = (shm_data_t *)params->shm_ptr;
  memcpy(shm_data->state, params->context_state, sizeof(double) * CONTEXT_DIM);

  // Set current performance metrics
  if (params->epoch_obj_count > 0) {
    shm_data->miss_ratio =
        params->epoch_obj_miss_count / params->epoch_obj_count;
  } else {
    shm_data->miss_ratio = 0.0;
  }

  if (params->epoch_byte_count > 0) {
    shm_data->byte_miss_ratio =
        params->epoch_byte_miss_count / params->epoch_byte_count;
  } else {
    shm_data->byte_miss_ratio = 0.0;
  }

  // Signal that inference is needed
  shm_data->ready_for_inference = 1;
  shm_data->timestamp = params->current_timestamp;

  // Release lock
  unlock_shared_memory(params);

  // Check if weights have been updated (non-blocking)
  if (shm_data->weights_updated) {
    // Acquire lock again
    lock_shared_memory(params);

    // Copy updated weights
    memcpy(params->weights, shm_data->weights, sizeof(double) * FEATURE_DIM);

    // Reset flag
    shm_data->weights_updated = 0;

    // Release lock
    unlock_shared_memory(params);

    // Print updated weights for debugging
    printf(
        "LOH: Updated weights from Actor-Critic: [%.3f, %.3f, %.3f, %.3f, "
        "%.3f, %.3f]\n",
        params->weights[0], params->weights[1], params->weights[2],
        params->weights[3], params->weights[4], params->weights[5]);
  }

  // Reset epoch statistics
  params->epoch_start_time = time(NULL);
  params->epoch_obj_miss_count = 0;
  params->epoch_obj_count = 0;
  params->epoch_byte_miss_count = 0;
  params->epoch_byte_count = 0;
}

