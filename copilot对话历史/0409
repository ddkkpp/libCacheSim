                    avg_sz, n_obj = float(m.group(4)), int(m.group(5))
    if r1v == 0: continue
    pct = ((c0-c1)/c1*100 if c1<=c0 else -(c1-c0)/c0*100) if max(c1,c0)>1e-9 else 0
    better = 'cpd1' if pct > 1 else ('cpd0' if pct < -1 else 'tie')
    data.append(dict(trace=t, c1=c1, c0=c0, pct=pct, better=better,
