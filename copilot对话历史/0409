import re

with open('tmp/20260407-cmaes-sweep/comparison_tables.md') as f:
    content = f.read()

# 表头列名 → 列索引
header_line = None
for line in content.split('\n'):
    if line.startswith('|') and 'Trace' in line:
        header_line = line
        break

hcells = [c.strip() for c in header_line.split('|')]

# 构建列名→索引映射
col_map = {}
for i, name in enumerate(hcells):
    if name:
        col_map[name] = i

# 需要对比的列
compare_cols = {
    'LOH': col_map.get('LOH'),
    'LOH(w0.3)': col_map.get('LOH(w0.3)'),
    'LOH(w0.5)': col_map.get('LOH(w0.5)'),
    'LOH(w0.7)': col_map.get('LOH(w0.7)'),
    'GDSF': col_map.get('GDSF'),
    'GDSF_new': col_map.get('GDSF_new'),
}

# 解析表格数据
sections = re.split(r'(^## .+$)', content, flags=re.MULTILINE)

for i, sec in enumerate(sections):
    if not (sec.startswith('## Miss Ratio') or sec.startswith('## Byte Miss Ratio')):
        continue
    metric = 'BMR' if 'Byte' in sec else 'MR'
    body = sections[i+1] if i+1 < len(sections) else ''

    # 收集所有数据
    data = {}  # {trace: {col_name: value}}
    for line in body.strip().split('\n'):
        if not line.startswith('|'):
            continue
        cells = [c.strip() for c in line.split('|')]
        if len(cells) < 10:
            continue
        if 'Trace' in cells[1] or '---' in cells[1] or cells[1].startswith('**'):
            continue
        trace = cells[1].replace('**','').strip()
        if not trace:
            continue
        row = {}
        for name, idx in compare_cols.items():
            if idx is not None and idx < len(cells):
                raw = cells[idx].replace('**','').strip()
                try:
                    row[name] = float(raw)
                except (ValueError, TypeError):
                    row[name] = None
            else:
                row[name] = None
        data[trace] = row

    print(f'\n=== {metric} ({len(data)} cloudphysics traces) ===')

    # LOH variants 两两对比
    variants = ['LOH', 'LOH(w0.3)', 'LOH(w0.5)', 'LOH(w0.7)']
    print(f'\n--- LOH 变体两两对比 (MR/BMR lower=better) ---')
    for a in variants:
        for b in variants:
            if a >= b:
                continue
            wins_a = wins_b = ties = 0
            adv_a = adv_b = 0.0
            for trace, row in data.items():
                va, vb = row.get(a), row.get(b)
                if va is None or vb is None:
                    continue
                if abs(va - vb) < 0.0001:
                    ties += 1
                elif va < vb:
                    wins_a += 1
                    adv_a += vb - va
                else:
                    wins_b += 1
                    adv_b += va - vb
            total = wins_a + wins_b + ties
            avg_a = f'{adv_a/wins_a:.4f}' if wins_a > 0 else '-'
            avg_b = f'{adv_b/wins_b:.4f}' if wins_b > 0 else '-'
            print(f'  {a} vs {b}: {a} wins {wins_a}, {b} wins {wins_b}, ties {ties} (total {total}) | avg adv: {avg_a} / {avg_b}')

    # GDSF vs GDSF_new
    print(f'\n--- GDSF vs GDSF_new ---')
    wins_g = wins_n = ties = 0
    for trace, row in data.items():
        vg, vn = row.get('GDSF'), row.get('GDSF_new')
        if vg is None or vn is None:
            continue
        if abs(vg - vn) < 0.0001:
            ties += 1
        elif vg < vn:
            wins_g += 1
        else:
            wins_n += 1
    print(f'  GDSF wins {wins_g}, GDSF_new wins {wins_n}, ties {ties}')

    # LOH(best variant) vs GDSF_new
    print(f'\n--- LOH(各变体) vs GDSF_new ---')
    for v in variants:
        wins_loh = wins_gdsf = ties = 0
        for trace, row in data.items():
            vl, vg = row.get(v), row.get('GDSF_new')
            if vl is None or vg is None:
                continue
            if abs(vl - vg) < 0.0001:
                ties += 1
            elif vl < vg:
                wins_loh += 1
            else:
                wins_gdsf += 1
        total = wins_loh + wins_gdsf + ties
        print(f'  {v} vs GDSF_new: {v} wins {wins_loh}, GDSF_new wins {wins_gdsf}, ties {ties} (total {total})')

