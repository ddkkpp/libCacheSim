        if vals_bmr:
            m=mean(vals_bmr)
            if m<best_bmr[1]: best_bmr=(c,m)
    best_mr_group[pref]=best_mr
    best_bmr_group[pref]=best_bmr

stats['recommendation']['best_fixed_combo_by_group_mr']=best_mr_group
stats['recommendation']['best_fixed_combo_by_group_bmr']=best_bmr_group

(out_dir/'stats.json').write_text(json.dumps(stats,ensure_ascii=False,indent=2),encoding='utf-8')
