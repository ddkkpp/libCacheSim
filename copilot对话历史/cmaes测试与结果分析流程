def find_section(text, header):
    """找到从 header 行开始到下一个 ## 之间的内容"""
    pat = re.compile(r'^' + re.escape(header) + r'.*$', re.M)
    m = pat.search(text)
    if not m:
        return None
    start = m.end()
    # 找下一个 ## 开头
    m2 = re.search(r'^\#\# ', text[start:], re.M)
    if m2:
        return text[start:start+m2.start()]
    return text[start:]

def parse_table(section, col_names_needed):
