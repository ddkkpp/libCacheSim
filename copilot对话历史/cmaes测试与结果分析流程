DIAG_FULL = re.compile(
    r'r1=(-?[\d.]+)\s+r2=(-?[\d.]+)\s+r3=(-?[\d.]+)\s+'
    r'r4=(-?[\d.]+)\s+r5=(-?[\d.]+)\s+r6=(-?[\d.]+)\s+'
    r'r_AB=(-?[\d.]+)\s+r_AC=(-?[\d.]+)\s+r_BC=(-?[\d.]+)\s+'
