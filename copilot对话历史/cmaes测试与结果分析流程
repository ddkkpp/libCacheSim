    r2_avg = sum(it['r2'] for it in items) / len(items)
    r3_avg = sum(it['r3'] for it in items) / len(items)
    print(f"  r1_avg={r1_avg:.4f} r2_avg={r2_avg:.4f} r3_avg={r3_avg:.4f}")

