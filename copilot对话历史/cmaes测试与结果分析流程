new_p = Path('tmp/20260418-drl-feature-sweep/logs/cachesim_sb3_meta_reag_f111_20260417_fix3.log')
old_p = Path('tmp/20260415-meta-rerun/logs/meta_reag_f111.log')

def parse(path):
    txt = path.read_text(errors='ignore').splitlines()
    hourly = {}
    final = None
    for ln in txt:
        m = re.search(r'LOH\s+(\d+\.\d+) hour: .*?miss ratio ([0-9.]+), interval miss ratio ([0-9.]+)', ln)
        if m:
            h = float(m.group(1))
            hourly[h] = (float(m.group(2)), float(m.group(3)))
        if 'cache size' in ln and 'miss ratio' in ln and 'byte miss ratio' in ln:
            fm = re.search(r'miss ratio\s+([0-9.]+), byte miss ratio\s+([0-9.]+), throughput\s+([0-9.]+)\s+MQPS, runtime\s+([0-9.]+)\s+sec', ln)
            if fm:
                final = tuple(float(fm.group(i)) for i in range(1,5))
    return hourly, final

new_h, new_f = parse(new_p)
old_h, old_f = parse(old_p)
print('NEW_FINAL', new_f)
print('OLD_FINAL', old_f)
if new_f and old_f:
    print('DELTA_FINAL miss_ratio={:+.6f} byte_miss_ratio={:+.6f} throughput={:+.3f} runtime={:+.2f}'.format(
        new_f[0]-old_f[0], new_f[1]-old_f[1], new_f[2]-old_f[2], new_f[3]-old_f[3]
    ))

hours = sorted(set(new_h.keys()) & set(old_h.keys()))
print('HOURS_COMMON', hours)
for h in hours:
    nm, ni = new_h[h]
    om, oi = old_h[h]
    print(f'HOUR {h:.0f} new_mr={nm:.4f} old_mr={om:.4f} delta_mr={nm-om:+.4f} new_imr={ni:.4f} old_imr={oi:.4f} delta_imr={ni-oi:+.4f}')
