def compute_stats(data, nreq, lru):
    traces = list(data.keys())
    n = len(traces)

    # Per-trace best
    best_per_trace = {}
    for t in traces:
        vals = data[t]
        idx = np.argmin(vals)
        best_per_trace[t] = (configs[idx], vals[idx])

    # Simple averages per config
    arr = np.array([data[t] for t in traces])  # shape (n_traces, 8)
    simple_avg = arr.mean(axis=0)
    best_avg_idx = np.argmin(simple_avg)

    # best_LOH (per-trace best, then avg/std/weighted)
    best_vals = np.array([best_per_trace[t][1] for t in traces])
    best_avg = best_vals.mean()
    best_std = best_vals.std()  # population std

    # Weighted average and std for best_LOH
    total_req = sum(nreq[t] for t in traces)
    weights = np.array([nreq[t] / total_req for t in traces])
    best_wavg = np.average(best_vals, weights=weights)
    best_wstd = np.sqrt(np.average((best_vals - best_wavg)**2, weights=weights))

    # Relative LRU for best_LOH
    lru_vals = np.array([lru[t] for t in traces])
    rel_lru = best_vals / lru_vals
    rel_lru_avg = rel_lru.mean()
    rel_lru_std = rel_lru.std()

    # Weighted relative LRU
    rel_lru_wavg = np.average(rel_lru, weights=weights)
    rel_lru_wstd = np.sqrt(np.average((rel_lru - rel_lru_wavg)**2, weights=weights))

    print(f"=== Group Stats ===")
    print(f"Traces: {traces}")
    for t in traces:
        print(f"  {t}: best={best_per_trace[t][0]} ({best_per_trace[t][1]:.6f})")
    print()
    print(f"Simple avg per config:")
    for i, c in enumerate(configs):
        mark = " **BEST**" if i == best_avg_idx else ""
        print(f"  {c}: {simple_avg[i]:.6f}{mark}")
    print()
    print(f"best_LOH stats:")
    print(f"  avg = {best_avg:.6f}")
    print(f"  std = {best_std:.6f}")
    print(f"  wavg = {best_wavg:.6f}")
    print(f"  wstd = {best_wstd:.6f}")
    print(f"  rel_lru_avg = {rel_lru_avg:.4f}")
    print(f"  rel_lru_std = {rel_lru_std:.4f}")
    print(f"  rel_lru_wavg = {rel_lru_wavg:.4f}")
    print(f"  rel_lru_wstd = {rel_lru_wstd:.4f}")
    print()

    # Also compute per-trace relative LRU
    for t in traces:
        print(f"  {t}: rel_LRU = {best_per_trace[t][1] / lru[t]:.4f}")
    print()

