    use_freq_size = (r1 > 0.90 and cv_freq_raw > 3.0)
    # rec_size 益于 r2 高或 one_hit 高
    use_rec_size = (r2 > 0.80 or one_hit > 0.85)
    use_freq_rec = True  # 默认

