        if r2 > 0.72:
            # cv_freq 高: freq_rec 可能有益
            if R2m_fr > 0.0 and cv_freq_raw > 7.0:
                if 'f100' in available_cfgs: return 'f100'
            # default for high r1, high r2: f001 (rec_size compound alone)
            if 'f001' in available_cfgs: return 'f001'
        else:
            # LOW r2: freq_size compound → f010 or f011
            if one_hit > 0.85:
                if 'f011' in available_cfgs: return 'f011'
            if 'f010' in available_cfgs: return 'f010'

    # 规则5: 中等 r1 → f101 (freq_rec + rec_size, 全能)
    if 'f101' in available_cfgs: return 'f101'
    if 'f111' in available_cfgs: return 'f111'
    return sorted(available_cfgs)[0]

def apply_rule_mr_v2(d, available_cfgs):
    r1 = d.get('r1', 1.0)
    r2 = d.get('r2', 1.0)
    one_hit = d.get('one_hit', 0.5)
    cv_freq_raw = d.get('cv_freq_raw', 5.0)
    cv_sz_raw = d.get('cv_sz_raw', 1.0)
    R2m_fr = d.get('R2m_fr', 0.5)

    # MR: nosize 极少最优，不建议使用
    has_size_cfgs = [c for c in available_cfgs if c != 'nosize']
    if not has_size_cfgs: return sorted(available_cfgs)[0]

    # LOW r1: f000 (no compound) 或 f011/f001
    if r1 < 0.55 and r2 > 0.75:
        if 'f000' in has_size_cfgs: return 'f000'

    if r1 < 0.70:
        # 需要 rec_size
        if 'f001' in has_size_cfgs: return 'f001'

    # HIGH r1 and HIGH r2
    if r1 > 0.90:
        if r2 > 0.78:
            # 都高: f011 (freq_size + rec_size)
            if 'f011' in has_size_cfgs: return 'f011'
        elif r2 > 0.50:
            # r2 中等: f101 (freq_rec + rec_size)
            if 'f001' in has_size_cfgs and cv_freq_raw > 6.5:
                if 'f001' in has_size_cfgs: return 'f001'
            if 'f101' in has_size_cfgs: return 'f101'
        else:
            # LOW r2: f010 (freq_size)
            if 'f010' in has_size_cfgs: return 'f010'

    # 默认
    if 'f101' in has_size_cfgs: return 'f101'
    return has_size_cfgs[0]

def eval_rule(rule_fn, records, mode='bmr'):
    total_oracle = total_rule = total_f111 = total_f101 = 0.0
    n_valid = 0
    gstats = defaultdict(lambda:{'n':0,'oracle':0.,'rule':0.,'f111':0.,'f101':0.})
    results = []
    for r in records:
        d = r['d']
        avail = r[f'all_{mode}']
        cfg_rule = rule_fn(d, avail)
        v_oracle = r[f'min_{mode}']
        v_rule = avail.get(cfg_rule, float('nan'))
        v_f111 = avail.get('f111', float('nan'))
        v_f101 = avail.get('f101', float('nan'))
        if math.isnan(v_rule): continue
        g = r['g']
        gstats[g]['n'] += 1; gstats[g]['oracle'] += v_oracle; gstats[g]['rule'] += v_rule
        if not math.isnan(v_f111): gstats[g]['f111'] += v_f111
        if not math.isnan(v_f101): gstats[g]['f101'] += v_f101
        total_oracle += v_oracle; total_rule += v_rule
        if not math.isnan(v_f111): total_f111 += v_f111
        if not math.isnan(v_f101): total_f101 += v_f101
        n_valid += 1
        results.append((r['t'], r['g'], r[f'best_cfg_{mode}'], v_oracle, cfg_rule, v_rule, v_f111))
    return n_valid, total_oracle, total_rule, total_f111, total_f101, gstats, results

