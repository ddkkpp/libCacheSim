    d = new_root / combo
    if not d.exists():
        continue
    for f in d.rglob('*.cachesim'):
        base = f.stem
        if '_' not in base:
            continue
        pref, trace = base.split('_',1)
        if pref not in all_groups:
            continue
        val = parse_cachesim(f)
        if val is None:
            continue
        data[pref].setdefault(trace,{})[combo] = val

