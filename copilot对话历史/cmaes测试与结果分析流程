        for c in combos_all:
            v = data[pref][t].get(c)
            row.append(f"{v[1]:.6f}" if v else "-")
        md.append("| " + " | ".join(row) + " |")

    (out_dir / f"{gname}.md").write_text("\n".join(md)+"\n", encoding='utf-8')

