import csv, os, re, statistics

# ===== 1) 读取 feature ablation summary.csv (含 r1, r2, 全部 8-config MR/BMR) =====
summaries = {}
# 合并多个 ablation 源
for summary_file in [
    "20260411-feature-ablation/summary.csv",
]:
    if not os.path.exists(summary_file): continue
    with open(summary_file) as f:
        reader = csv.DictReader(f)
        for row in reader:
            summaries[row["trace"]] = row

# 补充 wiki 和 ext 的数据 — 从 .cachesim 文件构建
res_dirs = [
    "20260411-feature-ablation/results",
    "20260413-feature-ablation-ext/results",
    "20260411-wiki-feature-ablation/results",
]
configs = ["f000","f001","f010","f011","f100","f101","f110","f111"]

# FSB trace → ablation 结果文件前缀映射
fsb_to_abl = {
    "alibaba_15": "alibabaBlock_15_new", "alibaba_17": "alibabaBlock_17_new",
    "alibaba_188": "alibabaBlock_188_new", "alibaba_210": "alibabaBlock_210_new",
    "alibaba_25": "alibabaBlock_25_new", "alibaba_256": "alibabaBlock_256_new",
    "alibaba_324": "alibabaBlock_324_new", "alibaba_401": "alibabaBlock_401_new",
    "alibaba_742": "alibabaBlock_742_new",
    "cluster3": "cluster3", "cluster49": "cluster49", "cluster7": "cluster7",
    "kv_202206": "202206_kv_traces_all", "meta_kvcache1": "meta_kvcache_traces_1",
    "meta_reag": "meta_reag", "meta_rprn": "meta_rprn",
    "tBlock_1063": "tencentBlock_1063", "tBlock_10927": "tencentBlock_10927",
    "tBlock_14833": "tencentBlock_14833", "tBlock_17226": "tencentBlock_17226",
    "tBlock_18304": "tencentBlock_18304", "tBlock_20067": "tencentBlock_20067",
    "tBlock_2115": "tencentBlock_2115", "tBlock_22734": "tencentBlock_22734",
    "tBlock_23479": "tencentBlock_23479", "tBlock_6554": "tencentBlock_6554",
    "w01": "w01", "w03": "w03", "w08": "w08", "w105": "w105",
    "w11": "w11", "w14": "w14", "w17": "w17", "w20": "w20",
    "w23": "w23", "w50": "w50", "w64": "w64", "w86": "w86",
    "w87": "w87", "w90": "w90", "w94": "w94",
    "wiki_2019t": "wiki_2019t", "wiki_2016u": "wiki_2016u", "wiki_2019u": "wiki_2019u",
    "tencent_photo1": "tencent_photo1",
}

# 从 .cachesim 读取 per-trace 8 configs MR/BMR
oracle_data = {}
for fsb_name, prefix in fsb_to_abl.items():
    d = {"mr": {}, "bmr": {}}
    for cfg in configs:
        fname = f"{prefix}_{cfg}.cachesim"
        path = None
        for rd in res_dirs:
            p = os.path.join(rd, fname)
            if os.path.exists(p):
                path = p; break
        if not path: continue
        with open(path) as f:
            content = f.read()
        for line in reversed(content.strip().split("\n")):
            if "LOH" in line:
                mr_m = re.search(r"miss ratio ([0-9.]+)", line)
                bmr_m = re.search(r"byte miss ratio ([0-9.]+)", line)
                if mr_m: d["mr"][cfg] = float(mr_m.group(1))
                if bmr_m: d["bmr"][cfg] = float(bmr_m.group(1))
                break
    if len(d["mr"]) == 8:
        d["mr_best_cfg"] = min(d["mr"], key=d["mr"].get)
        d["bmr_best_cfg"] = min(d["bmr"], key=d["bmr"].get)
        oracle_data[fsb_name] = d

# ===== 2) 确定 AUTO_COMPOUND v5 对每条 trace 的选择 =====
# v5 逻辑: FR=1 (固定), FS gated by r1>0.98, RS gated by r2>0.98
# config = f1{FS}{RS}
def auto_compound_v5(r1, r2):
    fs = 1 if r1 > 0.98 else 0
    rs = 1 if r2 > 0.98 else 0
    return f"f1{fs}{rs}"

ac_choices = {}
for fsb_name, prefix in fsb_to_abl.items():
    if prefix in summaries:
        row = summaries[prefix]
        r1_s = row.get("r1", "")
        r2_s = row.get("r2", "")
        if r1_s and r2_s:
            try:
                r1 = float(r1_s)
                r2 = float(r2_s)
                ac_choices[fsb_name] = auto_compound_v5(r1, r2)
            except:
                pass

# 检查有哪些 trace 没有 summary 数据（wiki 等）
missing_summary = []
for fsb_name in fsb_to_abl:
    prefix = fsb_to_abl[fsb_name]
    if prefix not in summaries:
        missing_summary.append((fsb_name, prefix))

if missing_summary:
    print("缺少 summary.csv 数据 (无法确定 AC_v5 选择):")
    for n, p in missing_summary:
        print(f"  {n} ({p})")
    print()

# ===== 3) 读取 FSB 结果 =====
fsb = {}
with open("20260415-fsb-v2-broad/all_results.tsv") as f:
    for line in f:
        if line.startswith("group"): continue
        parts = line.strip().split("\t")
        if len(parts) < 8 or parts[3] == "INCOMPLETE": continue
        trace, fsb_cfg = parts[1], parts[3]
        if fsb_cfg == "NO_LOCK": continue
        fsb[trace] = {"cfg": fsb_cfg}

# ===== 4) 做 3-way 比较: FSB vs AC_v5 vs Oracle =====
def grp_of(t):
    if t.startswith("alibaba"):       return "alibabaBlock"
    elif t.startswith("cluster"):     return "twitter"
    elif t.startswith("wiki"):        return "wiki"
    elif t.startswith("w"):           return "cloudphysics"
    elif t.startswith("kv_") or t.startswith("meta_kvcache"): return "metaKV"
    elif t.startswith("meta_r"):      return "metaCDN"
    elif t.startswith("tBlock"):      return "tencentBlock"
    elif t.startswith("tencent_photo"): return "tencentPhoto"
    return "unknown"

print(f"{'trace':<18} {'grp':<13} | {'FSB':>5} {'AC_v5':>5} {'Oracle':>6} | {'FSB_MR':>8} {'AC_MR':>8} {'Best_MR':>8} | {'FSB_reg%':>8} {'AC_reg%':>8} | {'FSB胜':>5}")
print("-"*130)

rows = []
for t in sorted(fsb.keys()):
    if t not in oracle_data: continue
    od = oracle_data[t]
    fcfg = fsb[t]["cfg"]
    oracle_cfg = od["mr_best_cfg"]
    best_mr = od["mr"][oracle_cfg]

    fsb_mr = od["mr"].get(fcfg, float('nan'))
    fsb_reg = (fsb_mr - best_mr) / best_mr * 100 if best_mr > 0 else 0

    ac_cfg = ac_choices.get(t, None)
    if ac_cfg:
        ac_mr = od["mr"].get(ac_cfg, float('nan'))
        ac_reg = (ac_mr - best_mr) / best_mr * 100 if best_mr > 0 else 0
    else:
        ac_mr = float('nan')
        ac_reg = float('nan')

    # FSB 是否胜出 AC
    if ac_cfg:
        fsb_wins = "YES" if fsb_mr < ac_mr - 1e-9 else ("TIE" if abs(fsb_mr - ac_mr) < 1e-9 else "")
    else:
        fsb_wins = "N/A"

    rows.append({
        "trace": t, "grp": grp_of(t),
        "fsb_cfg": fcfg, "ac_cfg": ac_cfg or "?", "oracle_cfg": oracle_cfg,
        "fsb_mr": fsb_mr, "ac_mr": ac_mr, "best_mr": best_mr,
        "fsb_reg": fsb_reg, "ac_reg": ac_reg, "fsb_wins": fsb_wins
    })

    ac_cfg_disp = ac_cfg or "?"
    print(f"{t:<18} {grp_of(t):<13} | {fcfg:>5} {ac_cfg_disp:>5} {oracle_cfg:>6} | {fsb_mr:>8.4f} {ac_mr:>8.4f} {best_mr:>8.4f} | {fsb_reg:>+7.2f}% {ac_reg:>+7.2f}% | {fsb_wins:>5}")

# ===== 5) 汇总 =====
valid = [r for r in rows if r["ac_cfg"] != "?"]
n = len(valid)
print(f"\n{'='*70}")
print(f"可对比的 trace: {n}")

fsb_regs = [r["fsb_reg"] for r in valid]
ac_regs = [r["ac_reg"] for r in valid]

print(f"\nFSB v2  MR regret: avg={sum(fsb_regs)/n:+.2f}% median={statistics.median(fsb_regs):+.2f}%")
print(f"AC  v5  MR regret: avg={sum(ac_regs)/n:+.2f}% median={statistics.median(ac_regs):+.2f}%")

fsb_win = sum(1 for r in valid if r["fsb_mr"] < r["ac_mr"] - 1e-9)
ac_win = sum(1 for r in valid if r["ac_mr"] < r["fsb_mr"] - 1e-9)
ties = n - fsb_win - ac_win
print(f"\nFSB 胜: {fsb_win}/{n} ({fsb_win/n*100:.1f}%)")
print(f"AC  胜: {ac_win}/{n} ({ac_win/n*100:.1f}%)")
print(f"平局:   {ties}/{n} ({ties/n*100:.1f}%)")

# 排除 alibaba_188
valid2 = [r for r in valid if r["trace"] != "alibaba_188"]
n2 = len(valid2)
fsb_regs2 = [r["fsb_reg"] for r in valid2]
ac_regs2 = [r["ac_reg"] for r in valid2]
print(f"\n排除 alibaba_188 (n={n2}):")
print(f"FSB v2  MR regret: avg={sum(fsb_regs2)/n2:+.2f}% median={statistics.median(fsb_regs2):+.2f}%")
print(f"AC  v5  MR regret: avg={sum(ac_regs2)/n2:+.2f}% median={statistics.median(ac_regs2):+.2f}%")

fsb_win2 = sum(1 for r in valid2 if r["fsb_mr"] < r["ac_mr"] - 1e-9)
ac_win2 = sum(1 for r in valid2 if r["ac_mr"] < r["fsb_mr"] - 1e-9)
ties2 = n2 - fsb_win2 - ac_win2
print(f"FSB 胜: {fsb_win2}/{n2} ({fsb_win2/n2*100:.1f}%)")
print(f"AC  胜: {ac_win2}/{n2} ({ac_win2/n2*100:.1f}%)")

# Per-group
groups = {}
for r in valid:
    g = r["grp"]
    if g not in groups: groups[g] = []
    groups[g].append(r)

print(f"\n{'group':<14} {'n':>3} {'FSB_avg':>9} {'AC_avg':>9} {'FSB_med':>9} {'AC_med':>9} {'FSB胜':>6} {'AC胜':>6}")
print("-"*70)
for g in sorted(groups.keys()):
    gs = groups[g]
    ng = len(gs)
    f_avg = sum(r["fsb_reg"] for r in gs)/ng
    a_avg = sum(r["ac_reg"] for r in gs)/ng
    f_med = statistics.median([r["fsb_reg"] for r in gs])
    a_med = statistics.median([r["ac_reg"] for r in gs])
    fw = sum(1 for r in gs if r["fsb_mr"] < r["ac_mr"] - 1e-9)
    aw = sum(1 for r in gs if r["ac_mr"] < r["fsb_mr"] - 1e-9)
    print(f"{g:<14} {ng:>3} {f_avg:>+8.1f}% {a_avg:>+8.1f}% {f_med:>+8.1f}% {a_med:>+8.1f}% {fw:>3}/{ng} {aw:>3}/{ng}")

