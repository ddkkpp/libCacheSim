    r'cv_sz=(-?[\d.]+)\s+cv_freq=(-?[\d.]+)\s+cv_rec=(-?[\d.]+)'
)
LINE_RE = re.compile(r'(\d+)\s+req,\s+miss ratio\s+([\d.]+),\s+byte miss ratio\s+([\d.]+)')

def classify_trace(name):
    if name.startswith("meta_kv"): return "metaKV"
    if name.startswith("meta_"): return "metaCDN"
    if name.startswith("tencent_photo"): return "tencentPhoto"
    if name.startswith("wiki_"): return "wiki"
    if name.startswith("w") and name[1:].split("_")[0].isdigit(): return "cloudphysics"
    if name.startswith("alibabaBlock"): return "alibabaBlock"
    if name.startswith("tencentBlock"): return "tencentBlock"
    if name.startswith("cluster"): return "twitter"
    if "kv" in name.lower(): return "metaKV"
    return "unknown"

# 收集结果
data = defaultdict(dict)
for d in RESULT_DIRS:
    if not os.path.isdir(d): continue
    for fn in os.listdir(d):
        m = re.match(r'^(.+)_(f[01]{3})\.cachesim$', fn)
        if not m: continue
        trace, cfg = m.group(1), m.group(2)
        fpath = os.path.join(d, fn)
        if os.path.getsize(fpath) == 0: continue
        with open(fpath) as f:
            for line in f:
                pm = LINE_RE.search(line)
                if pm:
                    data[trace][cfg] = (int(pm.group(1)), float(pm.group(2)), float(pm.group(3)))
                    break

# 收集 DIAG
diag = {}
for ld in LOG_DIRS:
    if not os.path.isdir(ld): continue
    for fn in os.listdir(ld):
        if not fn.endswith(".log"): continue
        m = re.match(r'^(.+)_(f[01]{3})\.log$', fn)
        if not m: continue
        trace = m.group(1)
        if trace in diag: continue
        with open(os.path.join(ld, fn)) as f:
            for line in f:
                if "WARMUP_DIAG" in line:
                    dm = DIAG_FULL.search(line)
                    if dm:
                        diag[trace] = {
                            'r1': float(dm.group(1)), 'r2': float(dm.group(2)), 'r3': float(dm.group(3)),
                            'r4': float(dm.group(4)), 'r5': float(dm.group(5)), 'r6': float(dm.group(6)),
                            'r_AB': float(dm.group(7)), 'r_AC': float(dm.group(8)), 'r_BC': float(dm.group(9)),
                            'R2m_fs': float(dm.group(10)), 'R2m_rs': float(dm.group(11)), 'R2m_fr': float(dm.group(12)),
                            'cv_sz': float(dm.group(13)), 'cv_freq': float(dm.group(14)), 'cv_rec': float(dm.group(15)),
                        }
                    break

# 找每个 trace 的 oracle config（MR 最低）和 oracle_bmr
CONFIGS = ["f000","f001","f010","f011","f100","f101","f110","f111"]
complete = {t for t,d in data.items() if len(d) == 8}

# 分析: 每个 trace 的 oracle MR config + 对应 r1/r2/r3
groups = defaultdict(list)
for t in sorted(complete):
    if t not in diag: continue
    d = diag[t]
    grp = classify_trace(t)
    mr_vals = {cfg: data[t][cfg][1] for cfg in CONFIGS}
    bmr_vals = {cfg: data[t][cfg][2] for cfg in CONFIGS}
    best_mr_cfg = min(mr_vals, key=mr_vals.get)
    best_bmr_cfg = min(bmr_vals, key=bmr_vals.get)
    # 联合 metric: 0.5*MR_rank + 0.5*BMR_rank
    groups[grp].append({
        'trace': t, 'r1': d['r1'], 'r2': d['r2'], 'r3': d['r3'],
        'R2m_fs': d['R2m_fs'], 'R2m_rs': d['R2m_rs'], 'R2m_fr': d['R2m_fr'],
        'cv_sz': d['cv_sz'], 'cv_freq': d['cv_freq'], 'cv_rec': d['cv_rec'],
        'best_mr': best_mr_cfg, 'best_bmr': best_bmr_cfg,
        'mr_vals': mr_vals, 'bmr_vals': bmr_vals,
    })

# 输出每组的 oracle MR config 分布 + r1/r2/r3 均值
print("=== 各组 oracle MR config 分布 ===")
for grp in ["metaCDN","metaKV","tencentPhoto","wiki","cloudphysics","alibabaBlock","tencentBlock","twitter"]:
    if grp not in groups: continue
    items = groups[grp]
    dist = defaultdict(int)
    for it in items: dist[it['best_mr']] += 1
    print(f"\n{grp} ({len(items)} traces):")
    for cfg in CONFIGS:
        if dist[cfg] > 0:
