export LOH_ENABLE_RL=1
export LOH_ENABLE_CMAES=0
export LOH_BUILD_RELEASE=1
export LOH_DEBUG_LEVEL=0
export CACHESIM_VERBOSE=0
export LOH_PERF_PROFILING=0
export LOH_ENABLE_PROFILING=0

# --- LOH configurations imported from non-RL meta-rerun script ---
export LOH_AUTO_COMPOUND=0
export LOH_SCORE_USE_IRT=0
export LOH_SCORE_USE_COMPOUND=1
export LOH_FEATURE_LOG1P=1
export LOH_RANDOM_CANDIDATES=256
export LOH_STRUCTURED_CANDIDATES=16

export LOH_TAIL_SAMPLE=1
export LOH_TAIL_SAMPLE_DECAY=0.99
export LOH_ADAPTIVE_BUDGET=1
export LOH_ASYNC_TRAIN=1
export LOH_WAIT_MODE=nonblocked
export LOH_SKIP_BUILD=1
export LOH_PARALLEL_SAFE=1
export LOH_MISS_RATIO_WEIGHT=1.0

# --- Redirect test_loh_rl_sb3.sh logs to the target LOG_DIR ---
export LOH_LOG_DIR="${LOG_DIR}"

# --- Feature configurations ---
CONFIGS=(
  "0 0 0"   # f000
  "0 0 1"   # f001
  "0 1 0"   # f010
  "0 1 1"   # f011
  "1 0 0"   # f100
  "1 0 1"   # f101
  "1 1 0"   # f110
  "1 1 1"   # f111
)

RUNNING=0
TOTAL=0
DONE=0
SKIPPED=0

declare -A PIDS

wait_slot() {
  while (( RUNNING >= MAX_PARALLEL )); do
    for pid in "${!PIDS[@]}"; do
      if ! kill -0 "$pid" 2>/dev/null; then
        wait "$pid" 2>/dev/null || true
        unset "PIDS[$pid]"
        RUNNING=$((RUNNING - 1))
        DONE=$((DONE + 1))
        if (( DONE % 50 == 0 )); then
            echo "[$(date '+%H:%M:%S')] DRL Sweep ($DONE/$TOTAL) finished."
        fi
      fi
    done
    if (( RUNNING >= MAX_PARALLEL )); then
      sleep 2
    fi
  done
}

echo "[$(date '+%H:%M:%S')] Tracking cachesim trace dependencies..."
TRACES=()
for rs_file in "${SRC_OUT_TMP}"/*.cachesim; do
    [[ -f "$rs_file" ]] || continue
    name=$(basename "$rs_file" .cachesim)
    TRACES+=("$name")
done

declare -A TRACE_PATHS
declare -A TRACE_TYPES

add_paths() {
    local dir="$1"
    local suffix="$2"
    local ttype="$3"
    while IFS= read -r -d '' f; do
        fname=$(basename "$f")
        bname=$(echo "$fname" | sed "s/${suffix}$//")
        TRACE_PATHS["$bname"]="$f"
        TRACE_TYPES["$bname"]="$ttype"
    done < <(find "$dir" -name "*${suffix}" -type f -print0)
}

echo "[$(date '+%H:%M:%S')] Building trace paths cache..."
add_paths "/mnt/serverpool/dingkp_trace/cloudphysics" ".bin.zst" "oracleGeneralBin"
add_paths "/mnt/serverpool/dingkp_trace/tencentBlock/v2/original" ".oracleGeneral.zst" "oracleGeneral"
add_paths "/mnt/serverpool/dingkp_trace/alibabaBlock/new" ".oracleGeneral.zst" "oracleGeneral"
add_paths "/mnt/serverpool/dingkp_trace/metaCDN" ".oracleGeneral.zst" "oracleGeneral"
add_paths "/mnt/serverpool/dingkp_trace/wiki" ".oracleGeneral.zst" "oracleGeneral"
add_paths "/mnt/serverpool/dingkp_trace/twitter" ".oracleGeneral.zst" "oracleGeneral"
add_paths "/mnt/serverpool/dingkp_trace/tencentPhoto" ".oracleGeneral.zst" "oracleGeneral"
add_paths "/mnt/serverpool/dingkp_trace/metaKV" ".oracleGeneral.zst" "oracleGeneral"
add_paths "/mnt/serverpool/dingkp_trace/metaKV" ".oracleGeneral.bin.zst" "oracleGeneralBin"

echo "[$(date '+%H:%M:%S')] Starting job dispatch..."

for trace_name in "${TRACES[@]}"; do
    tpath="${TRACE_PATHS[$trace_name]:-}"
    ttype="${TRACE_TYPES[$trace_name]:-}"

    if [[ -z "$tpath" ]]; then
        echo "WARNING: Path not found for $trace_name"
        continue
    fi

    for cfg in "${CONFIGS[@]}"; do
        read -r FR FS RS <<< "$cfg"
        CFG_NAME="f${FR}${FS}${RS}"
        LOG_PREFIX="${trace_name}_${CFG_NAME}"
        WRAPPER_LOG_FILE="${LOG_DIR}/${LOG_PREFIX}_wrapper.log"
        RES_FILE="${RES_DIR}/${LOG_PREFIX}.cachesim"

        # Check completed tasks
        if [[ -f "${LOG_DIR}/cachesim_sb3_${LOG_PREFIX}.log" ]] && grep -q "cache simulator exiting" "${LOG_DIR}/cachesim_sb3_${LOG_PREFIX}.log" 2>/dev/null; then
            SKIPPED=$((SKIPPED + 1))
            continue
        fi

        TOTAL=$((TOTAL + 1))
        wait_slot

        SHM_KEY=$(( 1000000 + TOTAL ))
        rm -f /dev/shm/loh_ac_${SHM_KEY}

        (
            export LOH_SHM_KEY=${SHM_KEY}
            export RUN_TIMESTAMP="${LOG_PREFIX}" # Injects RUN_TIMESTAMP logically
            export LOH_USE_FREQ_REC=$FR
            export LOH_USE_FREQ_SIZE=$FS
            export LOH_USE_REC_SIZE=$RS
            export PYTHONUNBUFFERED=1

            # Additional cleanup of Python / cachesim in case of zombie
            bash "${BASEDIR}/scripts/test_loh_rl_sb3.sh" "$tpath" 0.1 > "$WRAPPER_LOG_FILE" 2>&1
            rm -f /dev/shm/loh_ac_${SHM_KEY}
        ) &

        PIDS[$!]="${LOG_PREFIX}"
        RUNNING=$((RUNNING + 1))
    done
done

echo "[$(date '+%H:%M:%S')] All tasks dispatched. Waiting for completion..."

for pid in "${!PIDS[@]}"; do
  wait "$pid" 2>/dev/null || true
  DONE=$((DONE + 1))
done

echo "===== DRL Sweep DONE (total: $TOTAL, skipped: $SKIPPED, done: $DONE) ====="
