from pathlib import Path
import re, json, math
from statistics import mean

root = Path('/home/丁坤鹏/libcachesim_new')
out_dir = root / 'tmp/20260422-feature-combo-tables'
out_dir.mkdir(parents=True, exist_ok=True)

new_root = root / 'tmp/20260421-nosize-7combos-allgroups/results'
old_root = root / 'tmp/20260420-nosize-allgroups/results'

# 六组（用户要求）
groups = {
    'ab': 'alibabaBlock',
    'cp': 'cloudphysics',
    'mc': 'metaCDN',
    'mk': 'metaKV',
    'tb': 'tencentBlock',
    'wk': 'wiki',
}
all_groups = {
    'ab': 'alibabaBlock', 'cp': 'cloudphysics', 'mc': 'metaCDN', 'mk': 'metaKV',
    'tb': 'tencentBlock', 'wk': 'wiki', 'tw': 'twitter', 'tp': 'tencentPhoto'
}

combos_new = ['f000','f001','f010','f011','f101','f110','f111']
combos_all = ['f000','f001','f010','f011','f100','f101','f110','f111']

# parse cachesim
pat = re.compile(r'miss ratio\s+([0-9.]+),\s*byte miss ratio\s+([0-9.]+)')

def parse_cachesim(p: Path):
    try:
        txt = p.read_text(encoding='utf-8', errors='ignore')
    except Exception:
        return None
    m = pat.search(txt)
    if not m:
        return None
    return float(m.group(1)), float(m.group(2))

# data[group][trace][combo] = (mr,bmr)
data = {g:{} for g in all_groups}

# new 7 combos
