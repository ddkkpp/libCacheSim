print(hdr.format('Trace', 'f111 best Jnt', 'Sweep best Jnt', 'Gap abs', 'Gap %', 'f111 cfg', 'Sweep cfg'))
print('=' * 100)
for tr in traces:
    all_data = results[tr]
    f111 = [(c,p,mr,bmr,j) for c,p,mr,bmr,j in all_data if c=='f111']
    f111_best = min(f111, key=lambda x: x[4]) if f111 else ('f111','?',9,9,9)
    sweep_best = min(all_data, key=lambda x: x[4])
    gap = f111_best[4] - sweep_best[4]
    gap_pct = gap / sweep_best[4] * 100
    print("{:15} {:14.6f} {:14.6f} {:10.6f} {:7.2f}% {:>14} {:>14}".format(
        tr, f111_best[4], sweep_best[4], gap, gap_pct,
        f111_best[0]+'/'+f111_best[1], sweep_best[0]+'/'+sweep_best[1]))

# Per compound best Joint
print("\n=== BEST JOINT PER COMPOUND (grouped by trace) ===")
for tr in traces:
    compounds = {}
    for c, p, mr, bmr, j in results[tr]:
        if c not in compounds or j < compounds[c][4]:
            compounds[c] = (c, p, mr, bmr, j)
    best_j = min(v[4] for v in compounds.values())
    print("\n--- {} ---".format(tr))
    for c in sorted(compounds.keys()):
        _, p, mr, bmr, j = compounds[c]
        flag = " <-- BEST" if j == best_j else ""
        delta = (j - best_j) / best_j * 100
        print("  {}/{}: MR={:.6f} BMR={:.6f} Joint={:.6f} (+{:.2f}%){}".format(
            c, p, mr, bmr, j, delta, flag))

# Compare f011 vs f111 per trace (the key comparison)
print("\n=== f011 vs f111: MR / BMR / Joint ===")
print("{:15} {:>12} {:>12} {:>12} || {:>12} {:>12} {:>12} || {:>8} {:>8}".format(
