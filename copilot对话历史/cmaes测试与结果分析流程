    summary.sort(key=lambda x:(x['Avg Rank'],x['Avg Norm Score'],x['Max Regret']))
    return summary


def md_rank_table(summary):
    lines=[]
    lines.append('| Rank | Algorithm | Avg Rank | Wins | Avg Norm Score | Max Regret |')
    lines.append('|---:|---|---:|---:|---:|---:|')
    for i,s in enumerate(summary,1):
        alg=s['Algorithm']
        if alg=='best_LOH':
            alg='**best_LOH**'
        lines.append(f"| {i} | {alg} | {s['Avg Rank']:.2f} | {s['Wins']} | {s['Avg Norm Score']:.4f} | {s['Max Regret']:.6f} |")
    return '\n'.join(lines)


def md_detail_table(summary):
    lines=[]
    lines.append('| Algorithm | ' + ' | '.join(groups) + ' |')
    lines.append('|---|' + '|'.join(['---:']*len(groups)) + '|')
    for s in summary:
        alg=s['Algorithm']
        if alg=='best_LOH':
            alg='**best_LOH**'
        vals=[]
        for g in groups:
            v=s['ranks_by_group'][g]
            vals.append(f'**{v}**' if v==1 else str(v))
        lines.append('| ' + alg + ' | ' + ' | '.join(vals) + ' |')
    return '\n'.join(lines)

order=[
    ('MR 平均值','MR 平均值'),
    ('BMR 平均值','BMR 平均值'),
    ('MR 按请求数加权平均值','MR 加权平均值'),
    ('BMR 按请求数加权平均值','BMR 加权平均值'),
    ('MR 相对LRU比例','MR 相对LRU比例'),
    ('BMR 相对LRU比例','BMR 相对LRU比例'),
    ('MR 加权相对LRU比例','MR 加权相对LRU比例'),
    ('BMR 加权相对LRU比例','BMR 加权相对LRU比例'),
]

parts=[]
parts.append('# Baseline + LOH 算法 Robustness 汇总（8 groups）')
parts.append('')
parts.append('基于 baseline_summary_v3 + AUTO_COMPOUND(v4/v5) 数据，包含 best_LOH、v4-LOH、v5-LOH。')
parts.append('')
parts.append('**指标说明**:')
parts.append('- **Avg Rank**: 8 组 trace 上的平均排名（1=最优），越低越好（共 14 个算法）')
parts.append('- **Wins**: 在几组 trace 上排名第 1')
parts.append('- **Avg Norm Score**: 归一化得分平均（0=该组最优，1=该组最差），越低越好')
parts.append('- **Max Regret**: 与该组最优算法的最大绝对差距，越低越好')
parts.append('- 相对 LRU 比例表中，<1 优于 LRU，值越低越好')
parts.append('')

for key,title in order:
    summary=robustness(all_metrics[key])
    parts.append(f'## {title} — Robustness 排名')
    parts.append('')
    parts.append(md_rank_table(summary))
    parts.append('')
    parts.append(f'### {title} — 各组排名详情')
    parts.append('')
    parts.append(md_detail_table(summary))
    parts.append('')

out.write_text('\n'.join(parts),encoding='utf-8')
print(out)
