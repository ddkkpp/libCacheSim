def simulate_v5(r1_thresh, r2_thresh=0.98):
    """返回 {group: avg_joint}"""
    group_joints = {}
    for t in traces:
        d = diag[t]
        r1, r2 = d['r1'], d['r2']
        fr = 1  # FR always on in v5
        fs = 0 if r1 > r1_thresh else 1
        rs = 0 if r2 > r2_thresh else 1
        cfg = f"f{fr}{fs}{rs}"
        mr, bmr = results[(t, cfg)]
        joint = 0.5 * mr + 0.5 * bmr
        g = group_of(t)
        group_joints.setdefault(g, []).append(joint)
    return {g: sum(v)/len(v) for g, v in group_joints.items()}

# --- 5. 也做 v4 基准 ---
def simulate_v4(r1_thresh=0.98, r2_thresh=0.98):
