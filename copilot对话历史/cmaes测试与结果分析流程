import os, glob, re

RES_DIR = "tmp/20260411-feature-ablation/results"
CFGS = ["f000","f001","f010","f011","f100","f101","f110","f111"]

def parse_result(path):
    """解析 .cachesim 文件，返回 (mr, bmr) 或 None"""
    try:
        with open(path) as f:
            line = f.read().strip()
        mr = float(re.search(r'miss ratio ([\d.]+)', line).group(1))
        bmr = float(re.search(r'byte miss ratio ([\d.]+)', line).group(1))
        return mr, bmr
    except:
        return None

# trace -> group 映射
def get_group(trace_name):
    if trace_name.startswith('w') and (trace_name[1:].isdigit() or len(trace_name)<=4):
        return 'cloudphysics'
    if trace_name.startswith('alibabaBlock'):
        return 'alibaba'
    if trace_name.startswith('meta_kvcache'):
        return 'metaKV'
    if trace_name.startswith('meta_r'):
        return 'metaCDN'
    if trace_name.startswith('wiki'):
        return 'wiki'
    return None

# 读取所有结果
# dict: group -> cfg -> [(mr, bmr), ...]
from collections import defaultdict
data = defaultdict(lambda: defaultdict(list))

for cfg in CFGS:
    files = glob.glob(f"{RES_DIR}/*_{cfg}.cachesim")
    for fpath in files:
        trace_name = os.path.basename(fpath).replace(f"_{cfg}.cachesim", "")
        group = get_group(trace_name)
        if group is None:
            continue
        result = parse_result(fpath)
        if result:
            data[group][cfg].append(result)

# 输出每组每 cfg 的平均 MR 和 BMR
