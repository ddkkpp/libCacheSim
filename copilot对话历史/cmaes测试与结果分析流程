LINE_RE=re.compile(r'^(?P<trace>\S+)\s+(?P<algo>.+?)\s+cache size\s+(?P<size>[0-9.]+)(?P<unit>KiB|MiB|GiB|TiB),\s+(?P<req>[0-9]+) req, miss ratio (?P<mr>[0-9.]+), byte miss ratio (?P<bmr>[0-9.]+), throughput')

def canon(path):
    n=Path(path).name
    for s in ['.oracleGeneral.bin.zst','.oracleGeneral.zst','.oracleGeneral.bin','.oracleGeneral','.zst','.csv','.txt']:
        if n.endswith(s):
            n=n[:-len(s)]
    return n

def to_bytes(s):
    m=re.match(r'^\s*([0-9.]+)\s*(KiB|MiB|GiB|TiB)\s*$',s)
    if not m: return None
    return float(m.group(1))*UNIT[m.group(2)]

# cache size by group/trace from table1
