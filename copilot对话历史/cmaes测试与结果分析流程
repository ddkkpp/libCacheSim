import re, math
from pathlib import Path

root = Path('/home/丁坤鹏/libcachesim_new')
doc = root / 'docs/20260415-ablation-per-group/cmaes版本LOH/tencentBlock.md'
res_dir = root / 'tmp/20260415-baseline-fill/result'
missing_doc = root / 'docs/20260415-ablation-per-group/cmaes版本LOH/missing_baselines.md'

lines = doc.read_text(encoding='utf-8').splitlines()


def split_row(line):
    return [c.strip() for c in line.strip().split('|')[1:-1]]

def join_row(cells):
    return '| ' + ' | '.join(cells) + ' |'

def find_line(prefix):
    for i,l in enumerate(lines):
        if l.startswith(prefix):
            return i
    raise RuntimeError(prefix)

def parse_table(start_idx):
    # find header line
    i = start_idx
    while i < len(lines) and not lines[i].startswith('|'):
        i += 1
    h = i
    # separator
    i += 2
    rows = []
    while i < len(lines) and lines[i].startswith('|'):
        rows.append(i)
        i += 1
    return h, rows, i

# parse table1 n_req
i_t1 = find_line('## 表1:')
h1, r1, _ = parse_table(i_t1+1)
header1 = split_row(lines[h1])
idx_trace1 = header1.index('trace')
idx_nreq1 = header1.index('n_req')
nreq = {}
for ri in r1:
    cells = split_row(lines[ri])
    if not cells or cells[0].startswith('---'):
        continue
    tr = cells[idx_trace1]
    if tr.startswith('**'):
        continue
    nreq[tr] = int(cells[idx_nreq1].replace(',', ''))

pat = re.compile(r'LRB-BMR cache size\s+\S+,\s+\d+\s+req, miss ratio ([0-9.]+), byte miss ratio ([0-9.]+)')

def load_lrb(trace):
    f = res_dir / f'{trace}.cachesim'
    if not f.exists():
        return None
    txt = f.read_text(encoding='utf-8', errors='ignore')
    m = pat.search(txt)
    if not m:
        return None
    return float(m.group(1)), float(m.group(2))

# process table4 and table5
for sec_prefix, use_bmr in [('## 表4: Baseline MR 对比', False), ('## 表5: Baseline BMR 对比', True)]:
    si = find_line(sec_prefix)
    h, rows, _ = parse_table(si+1)
    header = split_row(lines[h])
    idx = {k:i for i,k in enumerate(header)}
    tcol = idx['trace']
    lrb_col = idx['LRB-BMR']
    lru_col = idx['LRU']

    # fill missing cells
    for ri in rows:
        cells = split_row(lines[ri])
        tr = cells[tcol]
        if tr.startswith('**'):
            continue
        if cells[lrb_col] != '—':
            continue
        v = load_lrb(tr)
        if v is None:
            continue
        cells[lrb_col] = f"{(v[1] if use_bmr else v[0]):.6f}"
        lines[ri] = join_row(cells)

    # recompute stats for LRB column
    vals, rels, wvals, wrels = [], [], [], []
    total = 0
    label_to_row = {}
    for ri in rows:
        cells = split_row(lines[ri])
        tr = cells[tcol]
        if tr.startswith('**'):
            label_to_row[tr] = ri
            continue
        total += 1
        lrb = cells[lrb_col]
        lru = cells[lru_col]
        if lrb == '—':
            continue
        try:
            x = float(lrb)
            y = float(lru)
        except ValueError:
            continue
        vals.append(x)
        w = nreq.get(tr)
        if w is not None:
            wvals.append((x,w))
        if y > 0:
            r = x / y
            rels.append(r)
            if w is not None:
                wrels.append((r,w))

    def pop_std(xs):
        if not xs:
            return None
        m = sum(xs)/len(xs)
        return math.sqrt(sum((x-m)*(x-m) for x in xs)/len(xs))

    def wstats(xw):
        if not xw:
            return None, None
        sw = sum(w for _,w in xw)
        if sw <= 0:
            return None, None
        m = sum(x*w for x,w in xw)/sw
        v = sum(w*(x-m)*(x-m) for x,w in xw)/sw
        return m, math.sqrt(v)

    cov = f"{len(vals)}/{total}"
    avg = sum(vals)/len(vals) if vals else None
    std = pop_std(vals)
    wavg, wstd = wstats(wvals)
    ravg = sum(rels)/len(rels) if rels else None
    rstd = pop_std(rels)
    wravg, wrstd = wstats(wrels)

    def set_stat(label, value, mode='raw'):
        ri = label_to_row.get(label)
        if ri is None:
            return
        cells = split_row(lines[ri])
        if mode == 'cov':
            cells[lrb_col] = value
        elif value is None:
            cells[lrb_col] = '—'
        elif mode == 'rel':
            cells[lrb_col] = f"{value:.4f}"
        else:
            cells[lrb_col] = f"{value:.6f}"
        lines[ri] = join_row(cells)

    set_stat('**覆盖数**', cov, 'cov')
    set_stat('**平均**', avg, 'raw')
    set_stat('**标准差**', std, 'raw')
    set_stat('**按请求数加权平均**', wavg, 'raw')
    set_stat('**按请求数加权标准差**', wstd, 'raw')
    set_stat('**相对LRU**', ravg, 'rel')
    set_stat('**相对LRU标准差**', rstd, 'rel')
    set_stat('**按请求数加权相对LRU**', wravg, 'rel')
    set_stat('**按请求数加权相对LRU标准差**', wrstd, 'rel')

# derive coverage from table4 LRB coverage row
si4 = find_line('## 表4: Baseline MR 对比')
h4, r4, _ = parse_table(si4+1)
header4 = split_row(lines[h4])
idx4 = {k:i for i,k in enumerate(header4)}
for ri in r4:
    cells = split_row(lines[ri])
    if cells[0] == '**覆盖数**':
        cov = cells[idx4['LRB-BMR']]
        break
else:
    raise RuntimeError('coverage row not found')
num, den = map(int, cov.split('/'))
miss = den - num

# update notes in tencentBlock.md
for i,l in enumerate(lines):
    if l.startswith('**Baseline 覆盖核定**:'):
        lines[i] = f'**Baseline 覆盖核定**: LRB-BMR 当前覆盖 {cov}（缺失 {miss}），其余算法全覆盖（见表4/表5覆盖行）'
    if l.startswith('覆盖不完整算法（平均值基于已测 trace）:'):
        lines[i] = f'覆盖不完整算法（平均值基于已测 trace）: LeCaR 4755/4755, LRB-BMR {cov}'

doc.write_text('\n'.join(lines) + '\n', encoding='utf-8')

# update missing_baselines.md for tencentBlock section
ml = missing_doc.read_text(encoding='utf-8').splitlines()
for i,l in enumerate(ml):
    if l.strip() == '## tencentBlock (4755 traces)':
        if i+2 < len(ml):
            ml[i+2] = f'LRB-BMR 仍缺失 {miss} 个 trace（当前覆盖 {cov}）；其余算法覆盖完整。'
        break
missing_doc.write_text('\n'.join(ml) + '\n', encoding='utf-8')

print(f'updated tencentBlock: LRB coverage {cov}, missing {miss}')
