import re

with open("docs/20260415-ablation-per-group/baseline_summary_v2.md", "r") as f:
    lines = f.readlines()

# 确定哪些表是"越小越好"（avg, weighted_avg），哪些需要"越大越好"或"越小越好"的判断
# 所有表的值都是指标值（MR、BMR、std、ratio 等）
# - MR/BMR 平均值/加权平均值: 越小越好
# - MR/BMR 标准差/加权标准差: 越小越好（更稳定更好）
# - 相对LRU比例 (ratio): 越小越好（<1 表示优于 LRU）
# - 覆盖率表: 不标注
# 总结：所有数值表（除覆盖率外）都是越小越好

out = []
i = 0
while i < len(lines):
    line = lines[i]

    # 修改标题和说明
    if line.startswith("# Baseline 算法汇总 v2"):
        out.append("# Baseline 算法汇总 v3（8 groups，去除 GDSF）\n")
        i += 1
        continue
    if "v2 更新说明" in line:
        out.append("**v3 更新说明**: 基于 v2，移除 GDSF 列，重新标注每行最优算法（不含 best_LOH）。\n")
        i += 1
        continue

    # 检测是否是表格行
    if line.startswith("|"):
        parts = line.split("|")
        # 表格行至少有 15 列 (空, trace/group, ARC, Cacheus, GDSF, GLCache, ..., 空)
        # GDSF 是第 5 列 (0-indexed: parts[5])
        if len(parts) >= 16:
            # 检测是否为表头
            header_check = parts[2].strip() if len(parts) > 2 else ""

            # 删除 GDSF 列 (index 5)
            new_parts = parts[:5] + parts[6:]

            # 是分隔符行？（含 --- 的行）
            is_separator = all(c in "-:|" for c in parts[3].strip()) if len(parts) > 3 else False

            # 是覆盖率表？（含 "/" 的数据）
            is_coverage = "/" in (parts[3].strip()) if len(parts) > 3 else False

            # 是表头行？
            is_header = header_check in ("group", "n_traces", "---:", "---")

            if not is_separator and not is_header and not is_coverage:
                # 数据行：找最优值（最小）并加粗标注
                # 算法列：从 index 3（ARC）到 倒数第2（ThreeLCache-BMR），不含 best_LOH（倒数第2）
                # new_parts: [空, group, n_traces, ARC, Cacheus, GLCache, LHD, LRU, LeCaR, S3FIFO, Sieve, WTinyLFU, LRB-BMR, ThreeLCache-BMR, best_LOH, 空]
                # 算法列 index: 3 到 len-3 (不含 best_LOH)
                algo_start = 3
                algo_end = len(new_parts) - 2  # 不含 best_LOH（倒数第2个非空）

                # 提取数值
                vals = {}
                for j in range(algo_start, algo_end):
                    cell = new_parts[j].strip().replace("**", "")
                    try:
                        v = float(cell)
                        vals[j] = v
                        new_parts[j] = f" {cell} "  # 去掉旧的加粗
                    except ValueError:
                        pass

                if vals:
                    min_val = min(vals.values())
                    for j, v in vals.items():
                        if v == min_val:
                            cell = new_parts[j].strip()
                            new_parts[j] = f" **{cell}** "

            out.append("|".join(new_parts))
            i += 1
            continue

    out.append(line)
    i += 1

with open("docs/20260415-ablation-per-group/baseline_summary_v3.md", "w") as f:
    f.writelines(out)

print(f"Done: {len(out)} lines written")
