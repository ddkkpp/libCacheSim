stats = {'groups':{}, 'global':{}, 'recommendation':{}}

# weights: use n_req from group docs table1
n_req = {}
for pref,gname in all_groups.items():
    fp = root / f'docs/20260415-ablation-per-group/cmaes版本LOH/{gname}.md'
    if not fp.exists():
        continue
    d = {}
    for line in fp.read_text(encoding='utf-8', errors='ignore').splitlines():
        if line.startswith('| ') and not line.startswith('|---'):
            cols = [x.strip() for x in line.strip().strip('|').split('|')]
            if len(cols) < 2:
                continue
            tr = cols[0]
            if tr in ('trace','**均值**','**标准差**'):
                continue
            try:
                d[tr] = int(cols[1].replace(',',''))
            except Exception:
                pass
    n_req[pref]=d

# fixed combo global means for MR/BMR
fixed_mr = {c:[] for c in combos_all}
fixed_bmr = {c:[] for c in combos_all}

for pref,gname in all_groups.items():
    traces = sorted(data[pref].keys())
    if not traces:
