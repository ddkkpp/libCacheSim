#!/usr/bin/env bash
# ============================================================
# mem_watchdog.sh — 内存看门狗 (for DRL sweep)
# 当系统已用内存超过 LIMIT_GB 时，按 etimes（进程存在时长）
# 升序杀死最新的 test_loh_rl_sb3.sh 及其子进程，并清理 SHM。
#
# 用法: nohup bash tmp/20260418-drl-feature-sweep/mem_watchdog.sh > tmp/20260418-drl-feature-sweep/watchdog.log 2>&1 &
# ============================================================
set -euo pipefail

LIMIT_GB=230       # 内存使用上限 (GiB)
INTERVAL=30        # 巡检间隔 (秒)
PATTERN="test_loh_rl_sb3.sh"

BASEDIR="/home/丁坤鹏/libcachesim_new/tmp/20260418-drl-feature-sweep"
REQUEUE_FILE="${BASEDIR}/requeue.txt"
LOG_DIR="${BASEDIR}/logs"

echo "[$(date)] watchdog started: LIMIT=${LIMIT_GB}GB, INTERVAL=${INTERVAL}s, PATTERN=${PATTERN}"

while true; do
  mem_total=$(awk '/^MemTotal/{print $2}' /proc/meminfo)
  mem_avail=$(awk '/^MemAvailable/{print $2}' /proc/meminfo)
  used_gb=$(( (mem_total - mem_avail) / 1048576 ))

  if (( used_gb >= LIMIT_GB )); then
    echo "[$(date)] WARNING: Memory ${used_gb}GB >= ${LIMIT_GB}GB limit, killing processes..."

    # 找最新的 test_loh_rl_sb3.sh
    pids_list=$(ps -eo pid,etimes,args --no-headers \
      | grep "${PATTERN}" \
      | grep "bash " \
      | grep -v "grep" \
      | sort -k2,2n || true)

    if [[ -z "$pids_list" ]]; then
      echo "[$(date)] No matching test_loh_rl_sb3.sh found, waiting..."
      sleep "$INTERVAL"
      continue
    fi

    # 提取最新的 target_pid
    target_pid=$(echo "$pids_list" | head -1 | awk '{print $1}')
    target_args=$(echo "$pids_list" | head -1 | awk '{for(i=3;i<=NF;i++) printf "%s ", $i; print ""}')

    echo "[$(date)] Targetting PID=$target_pid args=$target_args"

    # 从环境获取该进程关联的日志文件和 SHM_KEY
    shm_key=""
    trace_path=""
    if [[ -f /proc/"$target_pid"/environ ]]; then
      shm_key=$(tr '\0' '\n' < /proc/"$target_pid"/environ | grep "^LOH_SHM_KEY=" | cut -d= -f2 || true)
      log_prefix=$(tr '\0' '\n' < /proc/"$target_pid"/environ | grep "^RUN_TIMESTAMP=" | cut -d= -f2 || true)
    fi

    echo "[$(date)]   => Extracted SHM_KEY=${shm_key}, PREFIX=${log_prefix}"

    # 找到所有的子孙进程并清理
    children=$(pgrep -P "$target_pid" || true)
    if [[ -n "$children" ]]; then
        for child in $children; do
            grandchildren=$(pgrep -P "$child" || true)
            for gc in $grandchildren; do
                kill -9 "$gc" 2>/dev/null || true
            done
            kill -9 "$child" 2>/dev/null || true
        done
    fi
    kill -9 "$target_pid" 2>/dev/null || true

    # 手动清理共享内存
    if [[ -n "$shm_key" ]]; then
      echo "[$(date)]   => Wiping /dev/shm/loh_ac_${shm_key}"
      rm -f /dev/shm/loh_ac_${shm_key}
    fi

    # 删除可能残留的错误 logging / results
    if [[ -n "$log_prefix" ]]; then
      rm -f "${LOG_DIR}/ac_sb3_${log_prefix}.log"
      rm -f "${LOG_DIR}/cachesim_sb3_${log_prefix}.log"
      rm -f "${LOG_DIR}/${log_prefix}_wrapper.log"
      rm -f "${BASEDIR}/results/${log_prefix}.cachesim"
      echo "[$(date)]   => Cleaned outputs for ${log_prefix}"
    fi

    # 记录到 requeue
    echo "[$(date)] KILLED PID=$target_pid PREFIX=$log_prefix ARGS=$target_args" >> "$REQUEUE_FILE"

    sleep 10
  else
    sleep "$INTERVAL"
  fi
done
EOF
