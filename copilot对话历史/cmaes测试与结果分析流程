def compute_stats(vals, lru_vals, n_req):
    """Compute all stats for 表4/表5 summary rows."""
    avg = vals.mean()
    std = vals.std(ddof=0)
    w = n_req / n_req.sum()
    wavg = (w * vals).sum()
    wstd = np.sqrt((w * (vals - wavg)**2).sum())
    rel = vals / lru_vals
    rel_avg = rel.mean()
    rel_std = rel.std(ddof=0)
    wrel = (w * rel).sum()
    wrel_std = np.sqrt((w * (rel - wrel)**2).sum())
    return {
        "平均": avg, "标准差": std,
        "按请求数加权平均": wavg, "按请求数加权标准差": wstd,
        "相对LRU": rel_avg, "相对LRU标准差": rel_std,
        "按请求数加权相对LRU": wrel, "按请求数加权相对LRU标准差": wrel_std,
        "per_trace": vals, "per_trace_rel": rel,
    }

