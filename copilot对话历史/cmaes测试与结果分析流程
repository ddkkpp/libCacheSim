    md.append(f"- group: {gname}")
    md.append(f"- trace_count: {len(traces)}")
    md.append("- combos: f000 f001 f010 f011 f100 f101 f110 f111")
    md.append("- sources: tmp/20260421-nosize-7combos-allgroups/results + tmp/20260420-nosize-allgroups/results (as f100)\n")

    # MR table
    md.append("## MR table\n")
    md.append("| trace | f000 | f001 | f010 | f011 | f100 | f101 | f110 | f111 |")
    md.append("|---|---:|---:|---:|---:|---:|---:|---:|---:|")
    for t in traces:
        row = [t]
        for c in combos_all:
            v = data[pref][t].get(c)
            row.append(f"{v[0]:.6f}" if v else "-")
        md.append("| " + " | ".join(row) + " |")

    # BMR table
    md.append("\n## BMR table\n")
    md.append("| trace | f000 | f001 | f010 | f011 | f100 | f101 | f110 | f111 |")
    md.append("|---|---:|---:|---:|---:|---:|---:|---:|---:|")
    for t in traces:
