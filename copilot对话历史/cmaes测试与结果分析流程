    best_mr_cfg = min(CFGS, key=lambda c: sum(x[0] for x in data[group].get(c,[(99,99)])) / max(len(data[group].get(c,[(0,0)])),1))
    best_bmr_cfg = min(CFGS, key=lambda c: sum(x[1] for x in data[group].get(c,[(99,99)])) / max(len(data[group].get(c,[(0,0)])),1))
    for cfg in CFGS:
        vals = data[group].get(cfg, [])
        if not vals:
            print(f"{group:<15} {cfg:<6} {'0':>4} {'N/A':>8} {'N/A':>8}")
            continue
        avg_mr = sum(x[0] for x in vals) / len(vals)
        avg_bmr = sum(x[1] for x in vals) / len(vals)
        marker = ""
        if cfg == best_mr_cfg: marker += " <MR"
        if cfg == best_bmr_cfg: marker += " <BMR"
        print(f"{group:<15} {cfg:<6} {len(vals):>4} {avg_mr:>8.4f} {avg_bmr:>8.4f}{marker}")
