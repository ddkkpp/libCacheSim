Ran terminal command:  set -e
# 使用 awk 从 run.log 提取每个 mode/group 下 launch 的任务名；再用 find 统计 results 中 .cachesim 文件名（去后缀）
# 最后用 comm 求差集，得到“未完成任务”清单（expected - completed）
cd /home/丁坤鹏/libcachesim_new
for mode in mr bmr; do
  log="tmp/20260422-autocompound-cache0001-ready/$mode/run.log"
  outdir="tmp/20260422-autocompound-cache0001-ready/$mode/results"

  awk -v mode="$mode" '
    $0 ~ "mode=" mode " group=" {
      g=$0
      sub(/.*group=/, "", g)
      sub(/ .*/, "", g)
      cur=g
      next
    }
    $0 ~ / launch / {
      t=$0
      sub(/.* launch /, "", t)
      sub(/ .*/, "", t)
      sub("^" mode "/", "", t)
      if (cur != "") print cur "\t" t
    }
  ' "$log" | sort -u > "tmp/$mode.expected.tsv"

  find "$outdir" -maxdepth 1 -type f -name '*.cachesim' -printf '%f\n' | sed 's/\.cachesim$//' | sort -u > "tmp/$mode.completed.txt"

  cut -f2 "tmp/$mode.expected.tsv" | sort -u > "tmp/$mode.expected_tasks.txt"
  comm -23 "tmp/$mode.expected_tasks.txt" "tmp/$mode.completed.txt" > "tmp/$mode.unfinished.txt"

done

# 汇总输出：逐组 expected/completed/unfinished 数
for mode in mr bmr; do
  echo "=== $mode by group ==="
  awk -F'\t' '
    FNR==NR {exp[$1]++; task_group[$2]=$1; next}
    {
      t=$0; if (t in task_group) comp[task_group[t]]++;
    }
    END {
      for (g in exp) {
        c=(g in comp)?comp[g]:0;
        u=exp[g]-c;
        printf "%s\texpected=%d\tcompleted=%d\tunfinished=%d\n", g, exp[g], c, u;
      }
    }
  ' "tmp/$mode.expected.tsv" "tmp/$mode.completed.txt" | sort
  echo "TOTAL expected=$(wc -l < tmp/$mode.expected_tasks.txt) completed=$(wc -l < tmp/$mode.completed.txt) unfinished=$(wc -l < tmp/$mode.unfinished.txt)"
  echo

done

# 额外输出：未完成任务按组列出（前 200 行，避免刷屏）
for mode in mr bmr; do
  echo "=== $mode unfinished by group (first 200) ==="
  awk -F'\t' 'FNR==NR{tg[$2]=$1; next} {if ($0 in tg) print tg[$0] "\t" $0; else print "UNKNOWN\t" $0}' "tmp/$mode.expected.tsv" "tmp/$mode.unfinished.txt" | sort | head -n 200
  echo
done

