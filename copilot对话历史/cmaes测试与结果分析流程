for md in DOC_DIR.glob('*.md'):
    g=md.stem
    lines=md.read_text(encoding='utf-8',errors='ignore').splitlines()
    i=0
    while i<len(lines):
        if lines[i].startswith('## 表1'):
            i+=1
            while i<len(lines) and not lines[i].startswith('| trace |'): i+=1
            i+=2
            while i<len(lines) and lines[i].startswith('|'):
                parts=[p.strip() for p in lines[i].strip().strip('|').split('|')]
                if len(parts)>=3:
                    cache[g][parts[0]]=parts[2]
                i+=1
            break
        i+=1

# baseline index by trace
idx=defaultdict(list)
for fp in BASE.glob('*.cachesim'):
    txt=fp.read_text(encoding='utf-8',errors='ignore')
    for line in txt.splitlines():
        m=LINE_RE.match(line.strip())
        if not m: continue
        gd=m.groupdict()
        idx[canon(gd['trace'])].append((gd['algo'], float(gd['size'])*UNIT[gd['unit']]))

stats=Counter()
per_group=defaultdict(Counter)
examples=defaultdict(list)
with TSV.open('r',encoding='utf-8') as f:
    next(f)
    for line in f:
        if not line.strip():
            continue
        g,tr,mmr,mbmr,mu=line.rstrip('\n').split('\t')[:5]
        missing=[x for x in mu.split(',') if x]
        cbytes=to_bytes(cache[g].get(tr,''))
        recs=idx.get(tr,[])
        if not recs:
            cause='no_trace_key'
            for a in missing:
                stats[cause]+=1; per_group[g][cause]+=1
            if len(examples[(g,cause)])<5: examples[(g,cause)].append(tr)
            continue
        if not cbytes:
            cause='no_cache_size'
            for a in missing:
                stats[cause]+=1; per_group[g][cause]+=1
            continue
        matched=[r for r in recs if abs(r[1]-cbytes)/cbytes<=CACHE_TOL]
        if not matched:
            cause='no_cache_match'
            for a in missing:
                stats[cause]+=1; per_group[g][cause]+=1
            if len(examples[(g,cause)])<5: examples[(g,cause)].append(tr)
            continue
        algos={a for a,_ in matched}
        for a in missing:
            if a in algos:
                cause='scanner_false_missing'
            else:
                cause='algo_absent_at_cache'
            stats[cause]+=1; per_group[g][cause]+=1
            if cause!='algo_absent_at_cache' and len(examples[(g,cause)])<5:
                examples[(g,cause)].append(f'{tr}:{a}')

print('GLOBAL', dict(stats))
for g in sorted(per_group):
    print('GROUP', g, dict(per_group[g]))
for k,v in examples.items():
    print('EXAMPLE',k,v)
