并验证 v5a 是否仍优于 v4
"""
import os, re, glob

RESULT_DIR = "tmp/20260413-feature-ablation-ext/results"
LOG_DIR    = "tmp/20260413-feature-ablation-ext/logs"

# --- 1. 读取结果 ---
results = {}
new_traces = set()
for fpath in glob.glob(f"{RESULT_DIR}/*.cachesim"):
    fname = os.path.basename(fpath).replace(".cachesim", "")
    parts = fname.rsplit("_", 1)
    if len(parts) != 2 or not parts[1].startswith("f"):
        continue
    trace, cfg = parts
    # 只看 twitter (cluster*) 和 tencentPhoto
    if not (trace.startswith("cluster") or trace.startswith("tencent_photo")):
        continue
    with open(fpath) as f:
        content = f.read()
    m_mr = re.search(r'miss ratio (\d+\.\d+)', content)
    m_bmr = re.search(r'byte miss ratio (\d+\.\d+)', content)
    if m_mr and m_bmr:
        results[(trace, cfg)] = (float(m_mr.group(1)), float(m_bmr.group(1)))
        new_traces.add(trace)

# --- 2. 读取 WARMUP_DIAG ---
diag = {}
for fpath in glob.glob(f"{LOG_DIR}/*_f000.log"):
    fname = os.path.basename(fpath).replace("_f000.log", "")
    if fname not in new_traces:
        continue
    with open(fpath) as f:
        for line in f:
            if "WARMUP_DIAG" in line:
                vals = {}
                for m in re.finditer(r'(\w+)=([-\d.]+)', line):
                    vals[m.group(1)] = float(m.group(2))
                if 'r1' in vals:
                    diag[fname] = vals
                break

# --- 3. 分组 ---
def group_of(t):
    if t.startswith("cluster"): return "twitter"
    if t.startswith("tencent_photo"): return "tencentPhoto"
    return "other"

all_cfgs = [f"f{a}{b}{c}" for a in "01" for b in "01" for c in "01"]
traces = sorted([t for t in new_traces if all((t, c) in results for c in all_cfgs)])

print(f"完整 traces: {len(traces)}")
print(f"有 WARMUP_DIAG: {len(diag)}")
print()

# --- 4. 每个 trace 的 8 配置结果 ---
for grp in ["twitter", "tencentPhoto"]:
    grp_traces = [t for t in traces if group_of(t) == grp]
    if not grp_traces:
        continue

    print(f"{'='*100}")
    print(f"  {grp} ({len(grp_traces)} traces)")
    print(f"{'='*100}")

    for t in grp_traces:
        d = diag.get(t, {})
        r1 = d.get('r1', -1)
        r2 = d.get('r2', -1)
        r3 = d.get('r3', -1)

        print(f"\n--- {t} ---  r1={r1:.4f}  r2={r2:.4f}  r3={r3:.4f}")
        print(f"  {'Config':>6}  {'MR':>10}  {'BMR':>10}  {'Joint':>10}")

        best_cfg, best_j = None, float('inf')
        for c in all_cfgs:
            mr, bmr = results[(t, c)]
            j = 0.5*mr + 0.5*bmr
            if j < best_j:
                best_j, best_cfg = j, c
            print(f"  {c:>6}  {mr:>10.6f}  {bmr:>10.6f}  {j:>10.6f}")
        print(f"  Oracle: {best_cfg} (Joint={best_j:.6f})")

        # v4 决策
        if r1 >= 0:
            fr4 = 0
            fs4 = 0 if r1 > 0.98 else 1
            rs4 = 0 if r2 > 0.98 else 1
            cfg4 = f"f{fr4}{fs4}{rs4}"
            j4 = 0.5*results[(t,cfg4)][0] + 0.5*results[(t,cfg4)][1]

            fr5 = 1
            fs5 = 0 if r1 > 0.98 else 1
            rs5 = 0 if r2 > 0.98 else 1
            cfg5 = f"f{fr5}{fs5}{rs5}"
            j5 = 0.5*results[(t,cfg5)][0] + 0.5*results[(t,cfg5)][1]

            delta = (j5 - j4) / j4 * 100
            print(f"  v4→{cfg4} (Joint={j4:.6f})  v5a→{cfg5} (Joint={j5:.6f})  delta={delta:+.2f}%")

    # 组汇总
    print(f"\n--- {grp} 组汇总 ---")
    v4_joints = []
    v5_joints = []
    oracle_joints = []

    for t in grp_traces:
        d = diag.get(t, {})
        r1 = d.get('r1', -1)
        r2 = d.get('r2', -1)

        if r1 < 0:
            continue

        # v4
        cfg4 = f"f0{0 if r1 > 0.98 else 1}{0 if r2 > 0.98 else 1}"
        j4 = 0.5*results[(t,cfg4)][0] + 0.5*results[(t,cfg4)][1]
        v4_joints.append(j4)

        # v5a
        cfg5 = f"f1{0 if r1 > 0.98 else 1}{0 if r2 > 0.98 else 1}"
        j5 = 0.5*results[(t,cfg5)][0] + 0.5*results[(t,cfg5)][1]
        v5_joints.append(j5)

        # oracle
        best_j = min(0.5*results[(t,c)][0] + 0.5*results[(t,c)][1] for c in all_cfgs)
        oracle_joints.append(best_j)

    if v4_joints:
        avg_v4 = sum(v4_joints)/len(v4_joints)
        avg_v5 = sum(v5_joints)/len(v5_joints)
        avg_orc = sum(oracle_joints)/len(oracle_joints)
        delta = (avg_v5 - avg_v4) / avg_v4 * 100
        print(f"  v4    avg Joint: {avg_v4:.6f}")
        print(f"  v5a   avg Joint: {avg_v5:.6f}  (delta={delta:+.2f}%)")
        print(f"  Oracle avg Joint: {avg_orc:.6f}")

# --- 5. FR 边际效应 ---
print(f"\n\n{'='*80}")
print("FR 边际效应 (f0XX → f1XX 的 Joint 变化)")
print(f"{'='*80}")

for grp in ["twitter", "tencentPhoto"]:
    grp_traces = [t for t in traces if group_of(t) == grp]
    fr_deltas = []
    for t in grp_traces:
        for b1 in "01":
            for b2 in "01":
                cfg_off = f"f0{b1}{b2}"
                cfg_on = f"f1{b1}{b2}"
                j_off = 0.5*results[(t,cfg_off)][0] + 0.5*results[(t,cfg_off)][1]
                j_on = 0.5*results[(t,cfg_on)][0] + 0.5*results[(t,cfg_on)][1]
                fr_deltas.append((j_on - j_off) / j_off * 100)
    if fr_deltas:
        avg = sum(fr_deltas)/len(fr_deltas)
        fr_deltas.sort()
        med = fr_deltas[len(fr_deltas)//2]
        print(f"  {grp}: mean={avg:+.2f}%  median={med:+.2f}%  min={fr_deltas[0]:+.2f}%  max={fr_deltas[-1]:+.2f}%")

# --- 6. MR vs BMR 拆解 ---
print(f"\n{'='*80}")
print("FR 拆解: MR vs BMR 边际效应")
print(f"{'='*80}")

for grp in ["twitter", "tencentPhoto"]:
    grp_traces = [t for t in traces if group_of(t) == grp]
    mr_deltas = []
    bmr_deltas = []
    for t in grp_traces:
        for b1 in "01":
            for b2 in "01":
                cfg_off = f"f0{b1}{b2}"
                cfg_on = f"f1{b1}{b2}"
                mr_off, bmr_off = results[(t,cfg_off)]
                mr_on, bmr_on = results[(t,cfg_on)]
                if mr_off > 0:
                    mr_deltas.append((mr_on - mr_off) / mr_off * 100)
                if bmr_off > 0:
                    bmr_deltas.append((bmr_on - bmr_off) / bmr_off * 100)
    if mr_deltas:
        print(f"  {grp} MR:  mean={sum(mr_deltas)/len(mr_deltas):+.2f}%  median={sorted(mr_deltas)[len(mr_deltas)//2]:+.2f}%")
    if bmr_deltas:
        print(f"  {grp} BMR: mean={sum(bmr_deltas)/len(bmr_deltas):+.2f}%  median={sorted(bmr_deltas)[len(bmr_deltas)//2]:+.2f}%")
