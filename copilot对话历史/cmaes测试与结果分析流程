# ---- 解析表格 ----
# 表结构: 标题行 -> |---|...| -> 数据行 (8 行, 每组一行)
# 我们只关心 MR 平均值 和 BMR 平均值

ALGOS = ["ARC", "Cacheus", "GLCache", "LHD", "LRU", "LeCaR",
         "S3FIFO-0.1000-2", "Sieve", "WTinyLFU-w0.01-SLRU", "LRB-BMR", "ThreeLCache-BMR"]
GROUPS = ["alibabaBlock", "cloudphysics", "metaCDN", "metaKV",
          "tencentBlock", "tencentPhoto", "twitter", "wiki"]

def parse_table(lines, start_idx):
    """从 start_idx 开始解析一个 markdown 表格，返回 {group: {algo: value}}"""
    data = {}
    i = start_idx
    # 跳过标题行和分隔行
    while i < len(lines) and not lines[i].strip().startswith("|---"):
        i += 1
    i += 1  # 跳过 |---|
    # 读数据行
    while i < len(lines) and lines[i].strip().startswith("|"):
        parts = [p.strip() for p in lines[i].strip().split("|")]
        parts = [p for p in parts if p]  # 去空
        if len(parts) < 3:
            i += 1
            continue
        group = parts[0]
        if group not in GROUPS:
            i += 1
            continue
        vals = {}
        for j, algo in enumerate(ALGOS):
            raw = parts[j + 2]  # skip group, n_traces
            raw = raw.replace("**", "").strip()
            try:
                vals[algo] = float(raw)
            except:
                vals[algo] = None
        data[group] = vals
        i += 1
    return data

