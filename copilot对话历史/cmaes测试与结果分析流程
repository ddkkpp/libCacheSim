# -*- coding: utf-8 -*-
import re, os

resdir = 'tmp/20260416-per-feature-sweep/results/'
trace_prefixes = {
    'meta_reag': 'meta_reag',
    'meta_rnha': 'meta_rnha',
    'meta_rprn': 'meta_rprn',
    'meta_kvcache': 'meta_kvcache_traces_1',
    '202206_kv': '202206_kv_traces_all',
    '202210_kv': '202210_kv_traces_all_sort',
    '202401_kv': '202401_kv_traces_all_sort',
}

results = {}
for fname in sorted(os.listdir(resdir)):
    if not fname.endswith('.cachesim'):
        continue
    for tr, prefix in trace_prefixes.items():
        if fname.startswith(prefix + '_f'):
            m_f = re.search(r'_f(\d{3})_pf(\d{3})\.cachesim', fname)
            if m_f:
                compound = 'f' + m_f.group(1)
                perfeat = 'pf' + m_f.group(2)
                with open(os.path.join(resdir, fname)) as fh:
                    txt = fh.read()
                m_mr = re.search(r'miss ratio ([\d.]+), byte miss ratio ([\d.]+)', txt)
                if m_mr:
                    mr = float(m_mr.group(1))
                    bmr = float(m_mr.group(2))
                    joint = 0.5 * mr + 0.5 * bmr
                    if tr not in results:
                        results[tr] = []
                    results[tr].append((compound, perfeat, mr, bmr, joint))
            break

traces = ['meta_reag', 'meta_rnha', 'meta_rprn', 'meta_kvcache', '202206_kv', '202210_kv', '202401_kv']

