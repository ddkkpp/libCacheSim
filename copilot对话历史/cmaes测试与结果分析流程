    use_freq_size = (r1 > 0.95)           # r1高: freq和size强相关，freq_size compound有益
    use_rec_size = (r2 > 0.85 or one_hit > 0.90)  # r2高或one_hit高: rec_size compound有益
    use_freq_rec = True                   # 几乎总是有益

