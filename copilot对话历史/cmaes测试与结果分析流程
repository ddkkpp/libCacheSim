    lines = fp.read_text(encoding='utf-8', errors='ignore').splitlines()
    h4, r4 = parse_table(lines, '## 表4')
    h5, r5 = parse_table(lines, '## 表5')
    if not h4 or not h5:
        continue
    i4 = {k:n for n,k in enumerate(h4)}
    i5 = {k:n for n,k in enumerate(h5)}
    algos = [a for a in h4 if a != 'trace' and a != 'best_LOH']

