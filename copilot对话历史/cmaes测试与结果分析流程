import re, sys

def find_lecar_missing(filepath, table_start_lines):
    """Find traces with '—' in LeCaR column (column index 7, 0-based)"""
    with open(filepath) as f:
        lines = f.readlines()

    missing = {}  # table_name -> list of trace names
    current_table = None
    in_table = False

    for i, line in enumerate(lines, 1):
        # Detect table headers
        if '| trace |' in line and 'LeCaR' in line:
            # Determine if it's 表4 or 表5 based on line number
            if i in table_start_lines:
                current_table = table_start_lines[i]
            else:
                # Guess based on proximity
                current_table = f"table_at_line_{i}"
            in_table = True
            continue

        if in_table and line.startswith('|---'):
            continue

        if in_table and line.startswith('|'):
            cols = [c.strip() for c in line.split('|')]
            # Remove empty first/last from split
            cols = [c for c in cols if c != '']

            if len(cols) < 8:
                continue

            trace_name = cols[0].strip('* ')
            lecar_val = cols[7]  # LeCaR is column index 7

            if trace_name.startswith('**') or trace_name == 'trace':
                if '覆盖' in trace_name or '平均' in trace_name:
                    in_table = False
                continue

            if lecar_val == '—':
                if current_table not in missing:
                    missing[current_table] = []
                missing[current_table].append(trace_name)
        elif in_table and not line.startswith('|'):
            in_table = False

    return missing

