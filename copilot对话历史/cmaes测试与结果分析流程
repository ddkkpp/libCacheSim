def compute_robustness(data, metric_name):
    """
    data: {group: {algo: float}}
    返回每个算法的: rank_per_group, avg_rank, win_count, avg_norm_score, max_regret
    """
    ranks = {algo: [] for algo in ALGOS}
    norm_scores = {algo: [] for algo in ALGOS}
    regrets = {algo: [] for algo in ALGOS}

    rank_table = {}  # group -> {algo: rank}

    for group in GROUPS:
        vals = data[group]
        # 过滤 None
        valid = {a: v for a, v in vals.items() if v is not None}
        sorted_algos = sorted(valid.keys(), key=lambda a: valid[a])  # lower is better

        best_val = valid[sorted_algos[0]]
        worst_val = valid[sorted_algos[-1]]

        rank_table[group] = {}
        for rank_idx, algo in enumerate(sorted_algos):
            r = rank_idx + 1
            ranks[algo].append(r)
            rank_table[group][algo] = r

            # normalized score: 0=best, 1=worst
            if worst_val > best_val:
                ns = (valid[algo] - best_val) / (worst_val - best_val)
            else:
                ns = 0.0
            norm_scores[algo].append(ns)

            # regret: diff from best
            regrets[algo].append(valid[algo] - best_val)

    # 汇总
    results = []
    for algo in ALGOS:
        avg_rank = sum(ranks[algo]) / len(ranks[algo])
        wins = sum(1 for r in ranks[algo] if r == 1)
        avg_ns = sum(norm_scores[algo]) / len(norm_scores[algo])
        max_reg = max(regrets[algo])
        results.append({
            "algo": algo,
            "avg_rank": avg_rank,
            "wins": wins,
            "avg_norm_score": avg_ns,
            "max_regret": max_reg,
            "ranks": ranks[algo],
        })

    # 按 avg_rank 排序
    results.sort(key=lambda x: x["avg_rank"])
    return results, rank_table

# --- 输出 ---
