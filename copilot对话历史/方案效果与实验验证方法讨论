import re, os, glob, csv
from collections import defaultdict

# ─── 辅助 ───────────────────────────────────────────────────────────────────
def read_tsv(path):
    rows = []
    with open(path, newline='', errors='replace') as f:
        reader = csv.DictReader(f, delimiter='\t')
        for r in reader: rows.append(r)
    return rows

def parse_md_table_after(content, section_re):
    lines = content.split('\n')
    in_section, table_lines = False, []
    for line in lines:
        if re.search(section_re, line, re.IGNORECASE):
            in_section = True; table_lines = []; continue
        if in_section:
            if line.startswith('|'): table_lines.append(line)
            elif table_lines and not line.startswith('|') and line.strip(): break
    if len(table_lines) < 3: return []
    header = [c.strip() for c in table_lines[0].split('|')[1:-1]]
    rows = []
    for row_line in table_lines[2:]:
        vals = [c.strip() for c in row_line.split('|')[1:-1]]
        if len(vals) == len(header): rows.append(dict(zip(header, vals)))
    return rows

def collect_per_trace_lru(docs_dir):
    records = {}
    for md_path in sorted(glob.glob(f'{docs_dir}/*.md')):
        fname = os.path.basename(md_path)
        if 'summary' in fname.lower(): continue
        with open(md_path) as f: content = f.read()
        group = re.sub(r'\.md$', '', fname)
        mr_rows = parse_md_table_after(content, r'表4.*Baseline MR')
        bmr_rows = parse_md_table_after(content, r'表5.*Baseline BMR')
        lru_mr_map, lru_bmr_map = {}, {}
        for r in mr_rows:
            tr, lru = r.get('trace',''), r.get('LRU','')
            if tr and lru and lru not in ('', '-', 'N/A'):
                try: lru_mr_map[tr] = float(lru)
                except: pass
        for r in bmr_rows:
            tr, lru = r.get('trace',''), r.get('LRU','')
            if tr and lru and lru not in ('', '-', 'N/A'):
                try: lru_bmr_map[tr] = float(lru)
                except: pass
        for tr in set(list(lru_mr_map.keys()) + list(lru_bmr_map.keys())):
            records[tr] = {'group': group, 'lru_mr': lru_mr_map.get(tr), 'lru_bmr': lru_bmr_map.get(tr)}
    return records

MR_SUMMARY_PAT = re.compile(
    r'miss ratio\s+([\d.]+),\s*byte miss ratio\s+([\d.]+),\s*throughput\s+([\d.]+)\s*MQPS')

def extract_from_log(log_path):
    if not os.path.exists(log_path): return None
    try:
        with open(log_path, 'rb') as f: content = f.read().decode('utf-8', errors='replace')
        m = MR_SUMMARY_PAT.search(content)
        if m: return float(m.group(1)), float(m.group(2)), float(m.group(3))
    except: pass
    return None

