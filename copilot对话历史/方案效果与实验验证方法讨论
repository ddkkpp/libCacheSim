    log="$outdir/logs/${label}_${cache_label}.log"
    result="$PWD/$outdir/results/${label}_${cache_label}.out"
    if [[ -n "$evict_params" ]]; then
      env -i HOME="$HOME" PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" LD_LIBRARY_PATH="$LIBP" \
        "$BIN" "$TRACE" csv "$algo" "$cache_size" --trace-type-params "$PARAMS" --eviction-params "$evict_params" --report-interval=100000 --output "$result" \
        > "$log" 2>&1
    else
      env -i HOME="$HOME" PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" LD_LIBRARY_PATH="$LIBP" \
        "$BIN" "$TRACE" csv "$algo" "$cache_size" --trace-type-params "$PARAMS" --report-interval=100000 --output "$result" \
        > "$log" 2>&1
    fi
    strings -n 1 "$log" | grep ' byte miss ratio ' | tail -n 1
  }

  for cache in 0.1 0.001; do
    lrb_line=$(run_case "$cache" lrb_bmr LRB 'objective=byte-miss-ratio')
    tb_line=$(run_case "$cache" threel_bmr 3LCache 'objective=byte-miss-ratio')
    to_line=$(run_case "$cache" threel_omr 3LCache 'objective=object-miss-ratio')
    loh_line=$(run_case "$cache" loh LOH '')

    lrb=$(printf '%s' "$lrb_line" | sed -n 's/.*miss ratio \([0-9.]*\), byte miss ratio.*/\1/p')
    tb=$(printf '%s' "$tb_line" | sed -n 's/.*miss ratio \([0-9.]*\), byte miss ratio.*/\1/p')
    to=$(printf '%s' "$to_line" | sed -n 's/.*miss ratio \([0-9.]*\), byte miss ratio.*/\1/p')
    loh=$(printf '%s' "$loh_line" | sed -n 's/.*miss ratio \([0-9.]*\), byte miss ratio.*/\1/p')
    best_other=$(printf '%s\n%s\n%s\n' "$lrb" "$tb" "$to" | sort -n | head -n1)
    gap=$(awk -v a="$loh" -v b="$best_other" 'BEGIN{printf "%.6f", a-b}')
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$tag" "$cache" "$loh" "$lrb" "$tb" "$to" "$gap" >> "$BASE/results/summary.tsv"
  done
}

