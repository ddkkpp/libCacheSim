def build_group_table(cache_ratio, metric, lru_map):
    # metric='MR' -> 取 LOH_mr / LRU_mr;  metric='BMR' -> 取 LOH_bmr / LRU_bmr
    group_data = defaultdict(lambda: {'rel_mr_list': [], 'rel_bmr_list': [], 'rel_combo_list': [], 'n': 0})
    no_lru = 0
    for (grp, tr, cr, met), vals in pt.items():
        if cr != cache_ratio or met != metric: continue
        lru = lru_map.get(tr, {})
        lru_mr  = lru.get('lru_mr')
        lru_bmr = lru.get('lru_bmr')
        if lru_mr is None or lru_bmr is None:
            no_lru += 1; continue
        avg_mr  = sum(vals['mr'])  / len(vals['mr'])
        avg_bmr = sum(vals['bmr']) / len(vals['bmr'])
        rel_mr  = avg_mr  / lru_mr
        rel_bmr = avg_bmr / lru_bmr
        rel_combo = (rel_mr + rel_bmr) / 2
        group_data[grp]['rel_mr_list'].append(rel_mr)
        group_data[grp]['rel_bmr_list'].append(rel_bmr)
        group_data[grp]['rel_combo_list'].append(rel_combo)
        group_data[grp]['n'] += 1
    if no_lru: print(f"  [WARN] {no_lru} rows had no LRU match for cr={cache_ratio}, metric={metric}")
    # build rows
    rows = []
    for grp in sorted(group_data.keys()):
        d = group_data[grp]
        n = d['n']
        avg_rel_mr    = sum(d['rel_mr_list'])    / n
        avg_rel_bmr   = sum(d['rel_bmr_list'])   / n
        avg_rel_combo = sum(d['rel_combo_list']) / n
        rows.append({'group': grp, 'n': n,
                     'avg_rel_mr': avg_rel_mr, 'avg_rel_bmr': avg_rel_bmr, 'avg_rel_combo': avg_rel_combo})
    return rows

