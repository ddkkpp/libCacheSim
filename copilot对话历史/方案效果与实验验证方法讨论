            "loh_mr": loh_mr, "loh_bmr": loh_bmr,
            "lru_mr": lru_mr, "lru_bmr": lru_bmr,
            "rel_mr": loh_mr / lru_mr,
            "rel_bmr": loh_bmr / lru_bmr,
        })
    result = []
    for g in sorted(group_data):
        pts = group_data[g]
        n = len(pts)
        avg_loh_mr  = sum(p["loh_mr"]  for p in pts) / n
        avg_lru_mr  = sum(p["lru_mr"]  for p in pts) / n
        avg_rel_mr  = sum(p["rel_mr"]  for p in pts) / n
        avg_loh_bmr = sum(p["loh_bmr"] for p in pts) / n
