def fmt_table(rows, title):
    lines = [title, "", "| group | n | avg(rel_mr) | avg(rel_bmr) | avg(rel_combo) |",
             "|---|---:|---:|---:|---:|"]
    all_rel_mr, all_rel_bmr, all_rel_combo = [], [], []
    for r in rows:
        lines.append(f"| {r['group']} | {r['n']} | {r['avg_rel_mr']:.4f} | {r['avg_rel_bmr']:.4f} | {r['avg_rel_combo']:.4f} |")
        all_rel_mr.append(r['avg_rel_mr'])
        all_rel_bmr.append(r['avg_rel_bmr'])
        all_rel_combo.append(r['avg_rel_combo'])
    if rows:
        n_g = len(rows)
