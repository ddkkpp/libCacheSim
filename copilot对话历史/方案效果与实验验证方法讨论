def fmt_table_full(rows):
    hdr = "| group | n | avg_LOH_mr | avg_LRU_mr | avg(rel_mr) | avg_LOH_bmr | avg_LRU_bmr | avg(rel_bmr) | avg(rel_combo) |"
    sep = "|---|---:|---:|---:|---:|---:|---:|---:|---:|"
    lines = [hdr, sep]
    all_rel_mr, all_rel_bmr, all_combo = [], [], []
    for r in rows:
