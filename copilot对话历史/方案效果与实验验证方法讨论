def compute_table(rows, lru_map, cache_ratio_label, metric_filter, cfg_filter=None):
    """
    rows: list of dicts with group, trace, mr, bmr (LOH 结果)
    lru_map: {trace: {lru_mr, lru_bmr}}
    cache_ratio_label: '0.1' or '0.001'
