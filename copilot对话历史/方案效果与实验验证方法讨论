            f"| {r['avg_loh_bmr']:.4f} | {r['avg_lru_bmr']:.4f} | **{r['avg_rel_bmr']:.4f}** "
            f"| **{r['avg_rel_combo']:.4f}** |"
        )
        all_rel_mr.append(r['avg_rel_mr'])
        all_rel_bmr.append(r['avg_rel_bmr'])
