lru01   = collect_per_trace_lru('docs/20260422-ablation-per-group-cache01/cmaes版本LOH')
lru0001 = collect_per_trace_lru('docs/20260423-ablation-per-group-cache0001/cmaes版本')

# ─── per-group per-metric 统计（per-trace relative values then average）───────
def build_group_table(cache_ratio, metric, lru_map):
    """For each trace: compute rel_mr = LOH_mr/LRU_mr, rel_bmr = LOH_bmr/LRU_bmr.
    Then average per group. Return list of group rows."""
    # trace → (loh_mr list, loh_bmr list, loh_mqps list)
    trace_agg = defaultdict(lambda: {'mr': [], 'bmr': [], 'mqps': [], 'group': ''})
    for r in ok_rows:
        if r.get('cache_ratio','') != cache_ratio or r.get('metric','') != metric: continue
        if not r.get('status','').startswith('ok'): continue
        try: mr = float(r['mr']); bmr = float(r['bmr']); mqps = float(r['mqps'])
        except: continue
        key = r['trace']
        trace_agg[key]['mr'].append(mr)
        trace_agg[key]['bmr'].append(bmr)
        trace_agg[key]['mqps'].append(mqps)
        trace_agg[key]['group'] = r['group']

    group_stats = defaultdict(lambda: {
        'rel_mr_list': [], 'rel_bmr_list': [], 'rel_combo_list': [],
        'loh_mr_list': [], 'loh_bmr_list': [],
        'lru_mr_list': [], 'lru_bmr_list': [],
        'n': 0
    })
    for trace, vals in trace_agg.items():
        lru = lru_map.get(trace, {})
        lru_mr  = lru.get('lru_mr')
        lru_bmr = lru.get('lru_bmr')
        if lru_mr is None or lru_bmr is None or lru_mr <= 0 or lru_bmr <= 0:
            continue
        loh_mr  = sum(vals['mr'])  / len(vals['mr'])
        loh_bmr = sum(vals['bmr']) / len(vals['bmr'])
        rel_mr  = loh_mr  / lru_mr
        rel_bmr = loh_bmr / lru_bmr
        rel_combo = (rel_mr + rel_bmr) / 2
        grp = vals['group']
        g = group_stats[grp]
        g['rel_mr_list'].append(rel_mr)
        g['rel_bmr_list'].append(rel_bmr)
        g['rel_combo_list'].append(rel_combo)
        g['loh_mr_list'].append(loh_mr)
        g['loh_bmr_list'].append(loh_bmr)
        g['lru_mr_list'].append(lru_mr)
        g['lru_bmr_list'].append(lru_bmr)
        g['n'] += 1

    rows = []
    for grp in sorted(group_stats.keys()):
        g = group_stats[grp]
        n = g['n']
        if n == 0: continue
        avg = lambda lst: sum(lst)/len(lst)
        rows.append({
            'group': grp, 'n': n,
            'avg_loh_mr':  avg(g['loh_mr_list']),
            'avg_loh_bmr': avg(g['loh_bmr_list']),
            'avg_lru_mr':  avg(g['lru_mr_list']),
            'avg_lru_bmr': avg(g['lru_bmr_list']),
            'avg_rel_mr':  avg(g['rel_mr_list']),
            'avg_rel_bmr': avg(g['rel_bmr_list']),
            'avg_rel_combo': avg(g['rel_combo_list']),
        })
    return rows

