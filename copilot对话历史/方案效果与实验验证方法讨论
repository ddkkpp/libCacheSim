mkdir -p tmp/20260529-zipf-two-stage-tuning/logs tmp/20260529-zipf-two-stage-tuning/results && \
# cat <<'SH': 写入可复现实验脚本，统一生成 trace、运行 cachesim、汇总结果。
cat > tmp/20260529-zipf-two-stage-tuning/run_tuning.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail

# 常量: 使用隔离构建的 cachesim，固定 CSV 列映射。
BIN="$PWD/_build_rel_report_interval_100m_20260528/bin/cachesim"
PARAMS='time-col=1,obj-id-col=2,obj-size-col=3,obj-id-is-num=1,has-header=0'
BASE_DIR='tmp/20260529-zipf-two-stage-tuning'
LOG_DIR="$BASE_DIR/logs"
RES_DIR="$BASE_DIR/results"

# 环境: 仅提供运行所需动态库路径，避免污染。
export LD_LIBRARY_PATH="/home/丁坤鹏/libcmaes/build/src:/usr/local/lib:${LD_LIBRARY_PATH:-}"

# 网格: 控制规模，优先搜索更强短期局部性 + 不同噪声强度组合。
alphas=(1.05 1.15 1.25)
noise_evs=(32 64)
noise_bursts=(16 32)
noise_pools=(8192 16384)

# summary.tsv 列: cfg/noise/cache/algo/mr/bmr。
printf 'cfg\tnoise\tcache\talgo\tmr\tbmr\n' > "$RES_DIR/summary.tsv"

run_one_case() {
  local cfg="$1"
  local noise_flag="$2"
  local trace="$3"
  local cache_size="$4"
  local algo_label="$5"
  local algo_name="$6"
  local evict_params="$7"

  local log="$LOG_DIR/${cfg}_${noise_flag}_${algo_label}_cache${cache_size//./p}.log"
  local out="$RES_DIR/${cfg}_${noise_flag}_${algo_label}_cache${cache_size//./p}.out"

  # env -i: 干净 shell 运行，避免残留 LOH_* 环境变量影响结果。
  if [[ -n "$evict_params" ]]; then
    env -i HOME="$HOME" PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" LD_LIBRARY_PATH="/home/丁坤鹏/libcmaes/build/src:/usr/local/lib" \
      "$BIN" "$trace" csv "$algo_name" "$cache_size" --trace-type-params "$PARAMS" --eviction-params "$evict_params" --report-interval=100000 --output "$out" > "$log" 2>&1
  else
    env -i HOME="$HOME" PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" LD_LIBRARY_PATH="/home/丁坤鹏/libcmaes/build/src:/usr/local/lib" \
      "$BIN" "$trace" csv "$algo_name" "$cache_size" --trace-type-params "$PARAMS" --report-interval=100000 --output "$out" > "$log" 2>&1
  fi

  # sed: 从日志末行提取 MR/BMR。
  local final mr bmr
  final=$(strings -n 1 "$log" | grep ' byte miss ratio ' | tail -n 1 || true)
  mr=$(printf '%s' "$final" | sed -n 's/.*miss ratio \([0-9.]*\), byte miss ratio.*/\1/p')
  bmr=$(printf '%s' "$final" | sed -n 's/.*byte miss ratio \([0-9.]*\), throughput.*/\1/p')
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$cfg" "$noise_flag" "$cache_size" "$algo_label" "$mr" "$bmr" >> "$RES_DIR/summary.tsv"
}

# 生成与评测: 每个 cfg 生成 clean/noisy 两条 trace，跑 cache=0.1/0.001 与 LRB/3L(BMR/OMR)/LOH。
for alpha in "${alphas[@]}"; do
  for nev in "${noise_evs[@]}"; do
    for nburst in "${noise_bursts[@]}"; do
      for npool in "${noise_pools[@]}"; do
        cfg="a${alpha}_ev${nev}_nb${nburst}_np${npool}"
        cfg_dir="$BASE_DIR/$cfg"
        mkdir -p "$cfg_dir/clean" "$cfg_dir/noisy"

        # python3 clean: 生成无噪声 trace（noise-burst=0）作为基线。
        PATH="$PWD/.venv/bin:$PATH" python3 scripts/gen_zipf_noise_two_stage_trace.py \
          --output-dir "$cfg_dir/clean" \
          --num-objects 65536 \
          --num-requests 300000 \
          --alpha "$alpha" \
          --obj-size 4096 \
          --noise-pool "$npool" \
          --noise-every "$nev" \
          --noise-burst 0 \
          --seed 20260529 > "$LOG_DIR/${cfg}_clean_generate.log" 2>&1

        # python3 noisy: 生成有噪声 trace，参数仅改噪声强度。
        PATH="$PWD/.venv/bin:$PATH" python3 scripts/gen_zipf_noise_two_stage_trace.py \
          --output-dir "$cfg_dir/noisy" \
          --num-objects 65536 \
          --num-requests 300000 \
          --alpha "$alpha" \
          --obj-size 4096 \
          --noise-pool "$npool" \
          --noise-every "$nev" \
          --noise-burst "$nburst" \
          --seed 20260529 > "$LOG_DIR/${cfg}_noisy_generate.log" 2>&1

        clean_trace="$PWD/$cfg_dir/clean/zipf_noise_two_stage.csv"
        noisy_trace="$PWD/$cfg_dir/noisy/zipf_noise_two_stage.csv"

        for cache_size in 0.1 0.001; do
          run_one_case "$cfg" clean "$clean_trace" "$cache_size" lrb_bmr LRB 'objective=byte-miss-ratio'
          run_one_case "$cfg" clean "$clean_trace" "$cache_size" threel_bmr 3LCache 'objective=byte-miss-ratio'
          run_one_case "$cfg" clean "$clean_trace" "$cache_size" threel_omr 3LCache 'objective=object-miss-ratio'
          run_one_case "$cfg" clean "$clean_trace" "$cache_size" loh LOH ''

          run_one_case "$cfg" noisy "$noisy_trace" "$cache_size" lrb_bmr LRB 'objective=byte-miss-ratio'
          run_one_case "$cfg" noisy "$noisy_trace" "$cache_size" threel_bmr 3LCache 'objective=byte-miss-ratio'
          run_one_case "$cfg" noisy "$noisy_trace" "$cache_size" threel_omr 3LCache 'objective=object-miss-ratio'
          run_one_case "$cfg" noisy "$noisy_trace" "$cache_size" loh LOH ''
        done
      done
    done
  done
done

# python3: 汇总出 noisy 下双缓存 LOH 最优的配置与 clean/noisy 差值。
python3 - <<'PY'
import csv
from pathlib import Path

base = Path('tmp/20260529-zipf-two-stage-tuning/results')
rows = list(csv.DictReader((base/'summary.tsv').open(), delimiter='\t'))

# 索引: (cfg, noise, cache, algo) -> mr
mr = {}
for r in rows:
    key = (r['cfg'], r['noise'], r['cache'], r['algo'])
    if r['mr']:
        mr[key] = float(r['mr'])

cfgs = sorted({r['cfg'] for r in rows})

with (base/'winner_candidates.tsv').open('w', newline='') as f:
    w = csv.writer(f, delimiter='\t')
    w.writerow(['cfg','noisy_0p1_loh','noisy_0p1_best_other','noisy_0p001_loh','noisy_0p001_best_other','loh_best_both'])
    for cfg in cfgs:
        n01_loh = mr.get((cfg,'noisy','0.1','loh'))
        n001_loh = mr.get((cfg,'noisy','0.001','loh'))
        others01 = [mr.get((cfg,'noisy','0.1','lrb_bmr')), mr.get((cfg,'noisy','0.1','threel_bmr')), mr.get((cfg,'noisy','0.1','threel_omr'))]
        others001 = [mr.get((cfg,'noisy','0.001','lrb_bmr')), mr.get((cfg,'noisy','0.001','threel_bmr')), mr.get((cfg,'noisy','0.001','threel_omr'))]
        if None in [n01_loh, n001_loh] or any(x is None for x in others01+others001):
            continue
        b01 = min(others01)
        b001 = min(others001)
        ok = int(n01_loh < b01 and n001_loh < b001)
        w.writerow([cfg, f'{n01_loh:.6f}', f'{b01:.6f}', f'{n001_loh:.6f}', f'{b001:.6f}', ok])

# 找出第一个满足 noisy 双缓存 loh 最优的 cfg，并输出 clean/noisy 对照。
chosen = None
for r in csv.DictReader((base/'winner_candidates.tsv').open(), delimiter='\t'):
    if r['loh_best_both'] == '1':
        chosen = r['cfg']
        break

with (base/'chosen_delta.tsv').open('w', newline='') as f:
    w = csv.writer(f, delimiter='\t')
    w.writerow(['cfg','cache','algo','clean_mr','noisy_mr','delta_noisy_minus_clean'])
    if chosen is not None:
        for cache in ['0.1','0.001']:
            for algo in ['lrb_bmr','threel_bmr','threel_omr','loh']:
                c = mr.get((chosen,'clean',cache,algo))
                n = mr.get((chosen,'noisy',cache,algo))
                if c is None or n is None:
                    continue
                w.writerow([chosen, cache, algo, f'{c:.6f}', f'{n:.6f}', f'{(n-c):+.6f}'])

print('winner_candidates=', base/'winner_candidates.tsv')
print('chosen_delta=', base/'chosen_delta.tsv')
print('chosen_cfg=', chosen)
