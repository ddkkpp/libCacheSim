import glob, os, re
from collections import defaultdict

def read_head(path, max_bytes=200_000):
    with open(path, 'rb') as f:
        return f.read(max_bytes).decode('utf-8', errors='replace')

def read_tail_lines(path, max_lines=400):
    # simple tail without external deps
    # read chunks from end
    with open(path, 'rb') as f:
        f.seek(0, os.SEEK_END)
        size = f.tell()
        chunk = 8192
        data = b''
        pos = size
        while pos > 0 and data.count(b'\n') < max_lines + 5:
            pos = max(0, pos - chunk)
            f.seek(pos)
            data = f.read(size - pos) + data if pos == 0 else f.read(chunk) + data
            size = pos
        text = data.decode('utf-8', errors='replace')
        return text.splitlines()[-max_lines:]

def parse_ac_config(head, run_id):
    def m1(pat, flags=0):
        m = re.search(pat, head, flags)
        return m.group(1).strip() if m else None

    seed = m1(r"\bLOH_SEED:\s*(\d+)") or m1(r"\bLOH_SEED\s*=\s*(\d+)")

    # common knobs
    softmax = None
    m = re.search(r"\[LOH CONFIG\] Softmax activation: (ENABLED|DISABLED)", head)
    if m: softmax = 1 if m.group(1) == 'ENABLED' else 0
    if softmax is None:
        m = re.search(r"\bLOH_USE_SOFTMAX=(\d+)", head)
        if m: softmax = int(m.group(1))

    action_scale = m1(r"\bLOH_ACTION_SCALE=([0-9.]+)")
    feature_log1p = m1(r"\bLOH_FEATURE_LOG1P:\s*(\d+)") or m1(r"\bLOH_FEATURE_LOG1P=(\d+)")

    irt = m1(r"\bLOH_SCORE_USE_IRT=(\d+)")
    compound = m1(r"\bLOH_SCORE_USE_COMPOUND=(\d+)")

    # penalty enabled
    enable_pen = None
    m = re.search(r"\bLOH_ENABLE_PENALTY\b[^\n]*?:\s*1", head)
    if m: enable_pen = 1
    m = re.search(r"\bLOH_ENABLE_PENALTY\s*=\s*(\d+)", head)
    if m: enable_pen = int(m.group(1))

    # whether reward uses penalty (legacy semantics in old logs)
    use_pen = m1(r"\bLOH_REWARD_USE_PENALTY:\s*([^\s]+)")
    if use_pen is None:
        m = re.search(r"\bLOH_REWARD_USE_PENALTY=(\d+)", head)
        if m: use_pen = m.group(1)

    w_pen = m1(r"\bLOH_REWARD_W_PENALTY:\s*([0-9.]+)")
    if w_pen is None:
        m = re.search(r"\bLOH_REWARD_W_PENALTY=(\d+(?:\.\d+)?)", head)
        if m: w_pen = m.group(1)

    # penalty mode/scale + formula
    pen_mode = m1(r"\bLOH_PENALTY_MODE/LOH_PENALTY_SCALE:\s*([^\s]+)")
    if pen_mode is None:
        pen_mode = m1(r"\bPenalty scale mode:\s*([^\n]+)")
    formula = m1(r"\bLOH_PENALTY_REWARD_FORMULA:\s*([^\s]+)") or m1(r"\bPenalty reward formula:\s*([^\s]+)")

    # finer params might only appear in file name
    dmax = None
    m = re.search(r"dmax(?:=|_)(\d+)", run_id)
    if m: dmax = m.group(1)
    cutoff = None
    m = re.search(r"cutoff(?:=|_)(\d+)", run_id)
    if m: cutoff = m.group(1)

    return {
        'seed': seed,
        'softmax': softmax,
        'action_scale': action_scale,
        'feature_log1p': feature_log1p,
        'irt': irt,
        'compound': compound,
        'enable_penalty': enable_pen,
        'use_penalty': use_pen,
        'w_penalty': w_pen,
        'pen_mode': pen_mode,
        'formula': formula,
        'dmax': dmax,
        'cutoff': cutoff,
    }

def parse_cachesim(log_path):
    head = read_head(log_path, max_bytes=120_000)
    trace = None
    m = re.search(r"trace path:\s*([^,\n]+)", head)
    if m: trace = m.group(1).strip()

    cache_bytes = None
    m = re.search(r"\bCache size:\s*(\d+)", head)
    if m: cache_bytes = m.group(1)

    req = None
    m = re.search(r"processed\s+(\d+)\s+requests capped by the user", head)
    if m: req = m.group(1)

    miss = byte_miss = None
    for line in read_tail_lines(log_path, max_lines=600):
        m = re.search(r"miss ratio\s+([0-9.]+),\s*byte miss ratio\s+([0-9.]+)", line)
        if m:
            miss, byte_miss = m.group(1), m.group(2)
    return {'trace': trace, 'cache_bytes': cache_bytes, 'req': req, 'miss': miss, 'byte_miss': byte_miss}


def baseline_run_id(run_id):
    # best-effort:  <prefix>_p1_<anything>_<sNNN>(optional _pX)
    m = re.match(r"^(?P<prefix>.+)_p1_.*_(?P<seed>s\d+)(?:_p\d+)?$", run_id)
    if not m:
        return None
    return f"{m.group('prefix')}_p0_{m.group('seed')}"

# 1) find penalty-enabled ac logs after 0203
ac_logs = sorted(set(glob.glob('ac_sb3_0203*.log') + glob.glob('ac_sb3_0204*.log')))
pen_ac = []
for p in ac_logs:
    try:
        head = read_head(p, max_bytes=180_000)
    except Exception:
        continue
    if re.search(r"\bLOH_ENABLE_PENALTY\b[^\n]{0,40}[:=]\s*1\b", head):
        pen_ac.append(p)

runs = []
for ac_path in pen_ac:
    run_id = os.path.basename(ac_path)[len('ac_sb3_'):-len('.log')]
    cache_path = f"cachesim_sb3_{run_id}.log"
    if not os.path.exists(cache_path):
        continue

    ac_head = read_head(ac_path, max_bytes=220_000)
    ac_cfg = parse_ac_config(ac_head, run_id)
    c = parse_cachesim(cache_path)

    # baseline (only if same req)
    base_id = baseline_run_id(run_id)
    base = None
    if base_id:
        base_log = f"cachesim_sb3_{base_id}.log"
        if os.path.exists(base_log):
            base = parse_cachesim(base_log)
            if base.get('req') != c.get('req'):
                base = None

    runs.append({'run_id': run_id, 'ac': ac_cfg, 'c': c, 'baseline_id': base_id if base else None, 'baseline': base})

# group by trace
by_trace = defaultdict(list)
for r in runs:
    by_trace[r['c'].get('trace') or '(unknown)'].append(r)

# sort within trace
for t in by_trace:
    by_trace[t].sort(key=lambda r: (int(r['c']['req'] or 0), r['run_id']))

# build markdown
lines = []
lines.append('# LOH Penalty Runs Summary (0203+ / penalty enabled)')
lines.append('')
lines.append('本文件从 0203/0204 日志中筛选 `LOH_ENABLE_PENALTY=1` 的 run，汇总 penalty 相关配置与最终 miss/byte-miss 结果。')
lines.append('')
lines.append('说明：`LOH_ENABLE_PENALTY=1` 表示启用 penalty 机制（C 端编译期开关）。`LOH_REWARD_USE_PENALTY`（若出现在旧日志中）表示 reward 是否使用 penalty 项。')

cols = [
    'run_id','req','seed','trace','cache_bytes',
    'softmax','action_scale','log1p','irt','compound',
    'use_pen','pen_mode','formula','dmax','cutoff','w_pen',
    'miss','byte_miss','baseline','Δmiss','Δbyte'
]

def fmt(v):
    return '-' if v is None or v == '' else str(v)

for trace, items in sorted(by_trace.items(), key=lambda kv: kv[0]):
    lines.append('')
    lines.append(f'## Trace: {trace}')
    lines.append('')
    lines.append('|' + '|'.join(cols) + '|')
    lines.append('|' + '|'.join(['---']*len(cols)) + '|')
    for r in items:
        ac, c = r['ac'], r['c']
        base = r['baseline']
        dmiss = dbyte = None
        if base and c.get('miss') and base.get('miss'):
            try:
                dmiss = float(c['miss']) - float(base['miss'])
                dbyte = float(c['byte_miss']) - float(base['byte_miss'])
                dmiss = f"{dmiss:+.6f}"
                dbyte = f"{dbyte:+.6f}"
            except Exception:
                dmiss = dbyte = None

        row = {
            'run_id': r['run_id'],
            'req': c.get('req'),
            'seed': ac.get('seed'),
            'trace': trace,
            'cache_bytes': c.get('cache_bytes'),
            'softmax': ac.get('softmax'),
            'action_scale': ac.get('action_scale'),
            'log1p': ac.get('feature_log1p'),
            'irt': ac.get('irt'),
            'compound': ac.get('compound'),
            'use_pen': ac.get('use_penalty'),
            'pen_mode': ac.get('pen_mode'),
            'formula': ac.get('formula'),
            'dmax': ac.get('dmax'),
            'cutoff': ac.get('cutoff'),
            'w_pen': ac.get('w_penalty'),
            'miss': c.get('miss'),
            'byte_miss': c.get('byte_miss'),
            'baseline': r['baseline_id'],
            'Δmiss': dmiss,
            'Δbyte': dbyte,
        }
        lines.append('|' + '|'.join(fmt(row[c]) for c in cols) + '|')

lines.append('')
lines.append('## Notes')
lines.append('')
lines.append('- `baseline`：仅在能找到同 trace 且同 `req` 的 `_p0_` 对照日志时填写；否则为 `-`。')
lines.append('- `dmax/cutoff`：优先从文件名推断（仅对少数命名包含这些字段的 run 有值）。')

out_path = 'LOH_PENALTY_RUNS_0203_PLUS.md'
with open(out_path, 'w', encoding='utf-8') as f:
    f.write('\n'.join(lines) + '\n')

print(f"wrote {out_path} with {sum(len(v) for v in by_trace.values())} runs across {len(by_trace)} traces")
