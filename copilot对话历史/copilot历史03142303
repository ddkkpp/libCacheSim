compute_reuse() {
  local trace="$1" file="$2"
  awk -F: -v trace="$trace" '
    BEGIN{in_v=0;n=0;sum=0;total=0}
    /^# reuse virtual time:/ {in_v=1; next}
    /^#/ {next}
    in_v && NF==2 {
      v=$1+0; c=$2+0;
      n++; vals[n]=v; cnts[n]=c; sum+=v*c; total+=c;
    }
    END {
      q50=(total+1)*0.50; q90=(total+1)*0.90; q99=(total+1)*0.99;
      cum=0; p50=""; p90=""; p99="";
      for (k=1; k<=n; k++) {
        cum+=cnts[k];
        if (p50=="" && cum>=q50) p50=vals[k];
        if (p90=="" && cum>=q90) p90=vals[k];
        if (p99=="" && cum>=q99) p99=vals[k];
      }
      printf "recency_vtime\t%s\t%.0f\t%.6f\t%s\t%s\t%s\n", trace, total, sum/total, p50, p90, p99;
    }
  ' "$file"
}

compute_size() {
  local trace="$1" file="$2"
  awk -F: -v trace="$trace" '
    BEGIN{n=0;sum=0;total=0}
    /^#/ {next}
    NF==2 {
      v=$1+0; c=$2+0;
      n++; vals[n]=v; cnts[n]=c; sum+=v*c; total+=c;
    }
    END {
      q50=(total+1)*0.50; q90=(total+1)*0.90; q99=(total+1)*0.99;
      cum=0; p50=""; p90=""; p99="";
      for (k=1; k<=n; k++) {
        cum+=cnts[k];
        if (p50=="" && cum>=q50) p50=vals[k];
        if (p90=="" && cum>=q90) p90=vals[k];
        if (p99=="" && cum>=q99) p99=vals[k];
      }
      printf "size_req_weighted\t%s\t%.0f\t%.6f\t%s\t%s\t%s\n", trace, total, sum/total, p50, p90, p99;
    }
  ' "$file"
}

compute_pop() {
  local trace="$1" file="$2"
  awk -F: -v trace="$trace" '
    BEGIN{n=0;obj_total=0;req_total=0;sum=0;sumsq=0;maxf=0;one=0}
    /^#/ {next}
    NF==2 {
      f=$1+0; c=$2+0;
      n++; vals[n]=f; cnts[n]=c;
      obj_total+=c; req_total+=f*c; sum+=f*c; sumsq+=f*f*c;
      if (n==1) maxf=f;
      if (f==1) one=c;
    }
    END {
      mean=sum/obj_total;
      var=(sumsq/obj_total) - mean*mean;
      if (var < 0) var=0;
      cv=(mean>0)?sqrt(var)/mean:0;
      q50=(obj_total+1)*0.50; q90=(obj_total+1)*0.90; q99=(obj_total+1)*0.99;
      cum=0; p50=""; p90=""; p99="";
      for (k=n; k>=1; k--) {
        cum+=cnts[k];
        if (p50=="" && cum>=q50) p50=vals[k];
        if (p90=="" && cum>=q90) p90=vals[k];
        if (p99=="" && cum>=q99) p99=vals[k];
      }
      printf "frequency_obj\t%s\t%.0f\t%.6f\t%s\t%s\t%s\t%.6f\t%.6f\t%.6f\n", trace, obj_total, mean, p50, p90, p99, one/obj_total, cv, maxf/req_total;
    }
  ' "$file"
}

