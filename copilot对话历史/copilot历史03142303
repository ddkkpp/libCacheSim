        if str(row.get('exit_code','')).strip() != '0':
            return False
        for k in ('miss_ratio','byte_miss_ratio','throughput_mqps'):
            v=str(row.get(k,'')).strip()
            if not v or v.upper()=='NA':
                return False
        return True
    except Exception:
        return False

clean=[]
for key, rs in groups.items():
    # keep the last successful row if any; otherwise keep the last row
    succ=[row for row in rs if is_success(row)]
    if succ:
        clean.append(succ[-1])
    else:
        clean.append(rs[-1])

# preserve original ordering by idx (numeric) then rep

def key_sort(row):
    try:
        idx=int(str(row.get('idx','0')).strip())
    except Exception:
        idx=10**9
    try:
        rep=int(str(row.get('rep','0')).strip())
    except Exception:
        rep=10**9
    return (idx, rep)

clean.sort(key=key_sort)

with open(dst, 'w', newline='') as f:
    w=csv.DictWriter(f, fieldnames=fieldnames)
    w.writeheader()
    w.writerows(clean)

print('raw_rows', len(rows), 'clean_rows', len(clean))
