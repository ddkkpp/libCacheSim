    vals=[v for v in vals if v is not None]
    if not vals:
        return None, None
    m=sum(vals)/len(vals)
    if len(vals)<2:
        return m, 0.0
    v=sum((x-m)**2 for x in vals)/(len(vals)-1)
    return m, math.sqrt(v)

