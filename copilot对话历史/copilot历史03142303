    drop_prefixes = ('pen=', 'w_pen=', 'r_use_pen=', 'penonly=', 'formula=', 'seed=')
    toks=cfg.split()
    keep=[]
    for t in toks:
        if t.startswith(drop_prefixes):
            continue
        keep.append(t)
    return ' '.join(keep)

