import glob
import re
from pathlib import Path

doc = Path('LOH_TESTED_CONFIGS_SUMMARY.md').read_text(encoding='utf-8', errors='ignore')

summary_re = re.compile(r'(\d+)\s+req,\s+miss ratio\s+([0-9.]+),\s+byte miss ratio\s+([0-9.]+)')


def parse_summary(path: Path):
    # scan for last summary line (works even with ANSI codes)
    try:
        text = path.read_text(encoding='utf-8', errors='ignore')
    except Exception:
        return None
    m = None
    for m2 in summary_re.finditer(text):
        m = m2
    if not m:
        return None
    return int(m.group(1)), float(m.group(2)), float(m.group(3))


def infer_date(name: str) -> str:
    # prefer explicit _0204_ / _0205_ tokens, else any occurrence
    if '_0205_' in name or name.startswith('cachesim_sb3_0205_') or name.endswith('_0205.log'):
        return '20260205'
    if '_0204_' in name or name.startswith('cachesim_sb3_0204_') or name.endswith('_0204.log'):
        return '20260204'
    if '0205' in name:
        return '20260205'
    if '0204' in name:
        return '20260204'
    return 'unknown'


def run_id_from_cs(name: str) -> str:
    base = name
    if base.startswith('cachesim_sb3_'):
        base = base[len('cachesim_sb3_'):]
    if base.endswith('.log'):
        base = base[:-4]
    return base


def wbrify(run: str) -> str:
    return run.replace('_', '<wbr>_')


def infer_cfg(run: str) -> str:
    parts = []
    # algo/display
    if 'nosoft' in run:
        parts.append('SAC linear')
    elif 'soft' in run and 'nosoft' not in run:
        parts.append('SAC softmax')
    else:
        parts.append('SAC')

    if 'irt' in run:
        # ambiguous; skip
        pass

    if 'state2' in run:
        parts.append('state=2')

    if 'posnet' in run:
        parts.append('posnet=1')

    if 'sign0' in run:
        parts.append('signs=0')
    elif any(k in run for k in ['state', 'posnet', 'p0', 'p1', 'newp', 'oldp', 'bin20k', 'resume']):
        parts.append('signs=1')

    if '_p0' in run or run.endswith('p0'):
        parts.append('pen=0')
    if '_p1' in run or run.endswith('p1'):
        parts.append('pen=1')

    for seed in ['s124', 's125']:
        if seed in run:
            parts.append(f'seed={seed[1:]}')

    # weight tags
    m = re.search(r'wt(\d+(?:p\d+)?)', run)
    if m:
        parts.append(f'w_pen={m.group(1).replace("p", ".")}')

    if 'net2' in run:
        parts.append('formula=net2')
    elif 'net' in run:
        parts.append('formula=net')

    if 'baseline' in run:
        parts.append('baseline')

    if 'resume' in run:
        parts.append('resume')

    if 'bin20k' in run:
        parts.append('bin20k')

    if 'smoke' in run:
        parts.append('smoke')

    return ' '.join(parts)


