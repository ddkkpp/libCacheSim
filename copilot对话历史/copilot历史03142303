      END{mean=sum/obj_total; var=(sumsq/obj_total)-mean*mean; if(var<0)var=0; cv=(mean>0)?sqrt(var)/mean:0;
          q50=(obj_total+1)*0.50; q90=(obj_total+1)*0.90; q99=(obj_total+1)*0.99; cum=0; p50=""; p90=""; p99="";
