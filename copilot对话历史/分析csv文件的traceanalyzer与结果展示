import glob,re,statistics
from collections import defaultdict

files=sorted(glob.glob('tmp/20260429-loh-drl-vs-cmaes/logs/cmaes_*.log'))
case=[]
for fp in files:
    ws=[]; gens=[]
    with open(fp,'r',errors='ignore') as f:
        for ln in f:
            m=re.search(r'\[CMAES LOG\] gen=(\d+).*weights=\[([^\]]+)\]',ln)
            if not m:
                continue
            try:
                w=[float(x) for x in m.group(2).split(',')][:6]
            except:
                continue
            if len(w)<6:
                continue
            if any((x<0 or x>1) for x in w):
                continue
            ws.append(w); gens.append(int(m.group(1)))
    if not ws: continue
    s,e=ws[0],ws[-1]
    delta=sum(abs(e[i]-s[i]) for i in range(6))/6
    n05=sum(1 for i in range(6) if abs(e[i]-0.5)<=0.02)
    rng=sum((max(w[i] for w in ws)-min(w[i] for w in ws)) for i in range(6))/6
    name=fp.split('/')[-1]
    if 'recencytest_10m' in name: tr='recencytest_10m'
    elif 'lfutest2_10m' in name: tr='lfutest2_10m'
    else: tr='sizetest_10m'
    case.append((name,tr,max(gens),delta,n05,rng,e))

print('CASES',len(case))
print('GLOBAL',
      f"gen_avg={statistics.mean(x[2] for x in case):.1f}",
      f"delta_avg={statistics.mean(x[3] for x in case):.3f}",
      f"near05_avg={statistics.mean(x[4] for x in case):.2f}",
      f"range_avg={statistics.mean(x[5] for x in case):.3f}")
for tr in ['recencytest_10m','lfutest2_10m','sizetest_10m']:
    vals=[x for x in case if x[1]==tr]
    print(tr,
          f"delta_avg={statistics.mean(x[3] for x in vals):.3f}",
          f"near05_avg={statistics.mean(x[4] for x in vals):.2f}",
