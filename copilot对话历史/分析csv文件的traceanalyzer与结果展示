"""
生成 LRU 侧重的 10M trace（recency-dominant），高效版本
使用数组索引代替 OrderedDict，numpy 采样提速
"""
import numpy as np
import sys

NUM_REQ = 10_000_000
WINDOW_SIZE = 5000
REACCESS_PROB = 0.95
FIXED_SIZE = 10000
DECAY = 0.002

rng = np.random.default_rng(42)
next_obj_id = 0

# 用双向链表思路的数组实现：ring buffer
# window[0..wsize-1] = 对象 ID，tail 指向最近插入的位置
window = np.zeros(WINDOW_SIZE, dtype=np.int64)
wsize = 0   # 当前窗口实际大小
obj_set = set()  # 快速查重

# 预计算衰减权重表（窗口满时）
full_weights = np.array([(1 - DECAY) ** i for i in range(WINDOW_SIZE)], dtype=np.float64)
full_weights /= full_weights.sum()

out = open("lrutest_10m.csv", "w", buffering=1024*1024)

for t in range(NUM_REQ):
    if wsize == 0 or rng.random() > REACCESS_PROB:
        obj_id = next_obj_id
        next_obj_id += 1
    else:
        # 从窗口按 recency 衰减采样
        # window 按 recency 排列：window[wsize-1] 是最近的
        if wsize < WINDOW_SIZE:
            w = full_weights[:wsize]
            w = w / w.sum()
        else:
            w = full_weights
        idx = rng.choice(wsize, p=w)
        # idx=0 => 最近的 (window[wsize-1])
        obj_id = int(window[wsize - 1 - idx])

    out.write(f"{t},{obj_id},{FIXED_SIZE},-1\n")

    # 更新窗口 recency
    if obj_id in obj_set:
        # 移除旧位置，追加到末尾
        pos = np.where(window[:wsize] == obj_id)[0][0]
        window[pos:wsize-1] = window[pos+1:wsize]
        window[wsize - 1] = obj_id
    else:
        if wsize < WINDOW_SIZE:
            window[wsize] = obj_id
            wsize += 1
            obj_set.add(obj_id)
        else:
            evicted = int(window[0])
            obj_set.discard(evicted)
            window[:-1] = window[1:]
            window[-1] = obj_id
            obj_set.add(obj_id)

    if (t + 1) % 500_000 == 0:
        print(f"  {t+1}/{NUM_REQ} done, unique={next_obj_id}", file=sys.stderr)

out.close()
print(f"Done. total_req={NUM_REQ}, total_unique_obj={next_obj_id}", file=sys.stderr)
