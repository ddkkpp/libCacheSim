#!/usr/bin/env bash
set -euo pipefail

# 进入仓库根目录
cd /home/丁坤鹏/libcachesim_new

# 运行环境与工具参数
export LD_LIBRARY_PATH="/home/丁坤鹏/libcmaes/build/src:/usr/local/lib:${LD_LIBRARY_PATH:-}"
CSIM="_build_rel/bin/cachesim"
TPAR="-t time-col=1,obj-id-col=2,obj-size-col=3,obj-id-is-num=1"
OUT="tmp/20260430-lfu-param-sweep-quick"
TRACES="$OUT/traces"
LOGS="$OUT/logs"
RESULTS="$OUT/results.csv"

# sweep 网格：8 组（围绕当前有效区间）
HOT_LIST=(12000 30000)
PROB_LIST=(0.93 0.97)
ALPHA_LIST=(0.9 1.1)

# 并行度：同时最多跑 2 个配置（每个配置内部 4 算法顺序执行）
MAX_PAR=2

# 写 CSV 表头
echo "hot_objects,hot_prob,zipf_alpha,lru_mr,lfu_mr,size_mr,loh_mr,lfu_minus_loh" > "$RESULTS"

run_one() {
  local hot="$1"
  local prob="$2"
  local alpha="$3"
  local tag="h${hot}_p${prob//./}_a${alpha//./}"
  local trace="$TRACES/lfu_${tag}.csv"

  # 1) 生成 trace
  python3 scripts/gen_lfu_trace.py "$trace" "$hot" "$prob" "$alpha" > "$LOGS/gen_${tag}.log" 2>&1

  # 2) 分别运行 4 种算法并提取 miss ratio（对象 MR）
  local lru lfu size loh
  lru=$($CSIM "$trace" csv lru  0.1 $TPAR --num-req=0 2>&1 | tee "$LOGS/lru_${tag}.log"  | grep -oP 'miss ratio \K[0-9.]+(?=, byte)' | tail -1)
  lfu=$($CSIM "$trace" csv lfu  0.1 $TPAR --num-req=0 2>&1 | tee "$LOGS/lfu_${tag}.log"  | grep -oP 'miss ratio \K[0-9.]+(?=, byte)' | tail -1)
  size=$($CSIM "$trace" csv size 0.1 $TPAR --num-req=0 2>&1 | tee "$LOGS/size_${tag}.log" | grep -oP 'miss ratio \K[0-9.]+(?=, byte)' | tail -1)
  loh=$(LOH_ENABLE_CMAES=1 LOH_CMAES_SKIP_INIT_ASK=1 LOH_CMAES_INIT_FROM_WEIGHTS=0 \
      $CSIM "$trace" csv loh 0.1 $TPAR --num-req=0 2>&1 | tee "$LOGS/loh_${tag}.log" | grep -oP 'miss ratio \K[0-9.]+(?=, byte)' | tail -1)

  # 3) 计算 LFU-LOH 差值（<0 代表 LFU 更好）
  local delta
  delta=$(python3 - <<PY
lfu=float("$lfu")
loh=float("$loh")
print(f"{lfu-loh:.6f}")
PY
)

  # 4) 追加结果
  echo "${hot},${prob},${alpha},${lru},${lfu},${size},${loh},${delta}" | tee -a "$RESULTS"
}

# 参数组合并行执行
pids=()
for hot in "${HOT_LIST[@]}"; do
  for prob in "${PROB_LIST[@]}"; do
    for alpha in "${ALPHA_LIST[@]}"; do
      run_one "$hot" "$prob" "$alpha" &
      pids+=("$!")
      if (( ${#pids[@]} >= MAX_PAR )); then
        wait "${pids[@]}"
        pids=()
      fi
    done
  done
done

# 收尾等待
if (( ${#pids[@]} > 0 )); then
  wait "${pids[@]}"
fi

# 输出排序后的快速摘要（按 LFU-LOH 从小到大）
{
  head -1 "$RESULTS"
  tail -n +2 "$RESULTS" | sort -t, -k8,8g
} > "$OUT/results_sorted.csv"

echo "DONE"
echo "RESULTS=$RESULTS"
echo "SORTED=$OUT/results_sorted.csv"
EOF
# 赋予可执行权限
chmod +x tmp/20260430-lfu-param-sweep-quick/run.sh && \
# 确认脚本写入成功
echo "run.sh ready"

