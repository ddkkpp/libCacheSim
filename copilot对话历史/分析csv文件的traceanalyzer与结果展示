next_obj_id = 0

# 活跃池: [(obj_id, last_access_time), ...]
pool_ids = []
pool_last = []

out = open("lrutest_10m.csv", "w", buffering=1024*1024)

for t in range(NUM_REQ):
    if not pool_ids or random.random() < NEW_OBJ_PROB:
        obj_id = next_obj_id
        next_obj_id += 1
        # 加入池
        if len(pool_ids) >= POOL_SIZE:
            # 驱逐最久未访问的
            min_idx = pool_last.index(min(pool_last))
            pool_ids[min_idx] = obj_id
            pool_last[min_idx] = t
        else:
            pool_ids.append(obj_id)
            pool_last.append(t)
    else:
        # 按 recency 权重采样
        # weight = exp(-RECENCY_DECAY * (t - last))
        # 为避免 exp 计算，用 (1 - RECENCY_DECAY)^(t-last) 近似
        n = len(pool_ids)
        # 直接用 1/(1 + t - last) 作为权重更快
        weights = [1.0 / (1.0 + t - pool_last[i]) for i in range(n)]
        # random.choices 内部用累积和
        chosen = random.choices(range(n), weights=weights, k=1)[0]
        obj_id = pool_ids[chosen]
        pool_last[chosen] = t

    out.write(f"{t},{obj_id},{FIXED_SIZE},-1\n")

    if (t + 1) % 500_000 == 0:
        print(f"  {t+1}/{NUM_REQ} done, unique={next_obj_id}", file=sys.stderr)

out.close()
print(f"Done. total_req={NUM_REQ}, total_unique_obj={next_obj_id}", file=sys.stderr)
PYEOF
echo "v3 script ready"

