import glob,re,statistics
from collections import defaultdict

files=sorted(glob.glob('tmp/20260429-loh-drl-vs-cmaes/logs/cmaes_*.log'))
case_stats=[]
for fp in files:
    gens=[]; ws=[]
    with open(fp,'r',errors='ignore') as f:
        for ln in f:
            m=re.search(r'\[CMAES LOG\] gen=(\d+).*weights=\[([^\]]+)\]',ln)
            if not m:
                continue
            try:
                w=[float(x) for x in m.group(2).split(',')]
            except Exception:
                continue
            if len(w) < 6:
                continue
            gens.append(int(m.group(1)))
            ws.append(w[:6])
    if not ws:
        continue

    start,end=ws[0],ws[-1]
    l1=sum(abs(end[i]-start[i]) for i in range(6))/6
    near05=sum(1 for i in range(6) if abs(end[i]-0.5)<=0.02)
    rng=[max(w[i] for w in ws)-min(w[i] for w in ws) for i in range(6)]
    avg_rng=sum(rng)/6
    name=fp.split('/')[-1]
    case_stats.append((name,max(gens),l1,near05,avg_rng,end))

print('CMAES_CASES',len(case_stats))
print('AVG: gen,delta_start_end,near05_dims,avg_dim_range')
print(f"{statistics.mean(x[1] for x in case_stats):.1f} {statistics.mean(x[2] for x in case_stats):.3f} {statistics.mean(x[3] for x in case_stats):.2f} {statistics.mean(x[4] for x in case_stats):.3f}")

# near-0.5 strong cases
