"""
LRU 侧重 10M trace 生成器 v4（真正高效）

思路：完全摒弃 per-step 采样。
改用"分层请求序列生成"：
1. 对象 i 在时刻 t_i 首次出现
2. 之后以指数递减的间隔重复访问（recency decay）
3. 所有对象 size 相同（消除 size 影响）
4. 由于间隔递增，最近访问的对象最可能出现在下一个时间步

实际方法：生成 arrival + geometric reaccess 事件列表，排序后截取到 10M
"""
import numpy as np
import sys

NUM_REQ = 10_000_000
FIXED_SIZE = 10000
NUM_OBJECTS = 200000    # 总共会使用的对象数
ARRIVAL_RATE = 20       # 平均每 20 步引入一个新对象
AVG_REACCESS = 5        # 平均重访间隔（步数），几何分布参数 p=1/5

rng = np.random.default_rng(42)

print("Generating events...", file=sys.stderr)

# 每个对象的首次到达时间（泊松过程）
arrivals = np.cumsum(rng.exponential(ARRIVAL_RATE, size=NUM_OBJECTS)).astype(np.int64)
# 只保留首次到达在 NUM_REQ 之前的对象
arrivals = arrivals[arrivals < NUM_REQ]
actual_objects = len(arrivals)
print(f"  {actual_objects} objects with arrivals before {NUM_REQ}", file=sys.stderr)

# 为每个对象生成重访序列
events = []  # [(time, obj_id), ...]
p_reaccess = 1.0 / AVG_REACCESS

for i in range(actual_objects):
    t = int(arrivals[i])
    events.append((t, i))
    while True:
        # 几何分布重访间隔：每次间隔变大（体现 recency 衰减 / 兴趣消退）
        gap = rng.geometric(p_reaccess)
        t += int(gap)
        if t >= NUM_REQ:
            break
        events.append((t, i))

    if (i + 1) % 50000 == 0:
        print(f"  {i+1}/{actual_objects} objects, {len(events)} events so far", file=sys.stderr)

print(f"  Generated {len(events)} total events for {actual_objects} objects", file=sys.stderr)

# 按时间排序，截取前 NUM_REQ
print("Sorting events...", file=sys.stderr)
events.sort(key=lambda x: x[0])
if len(events) > NUM_REQ:
    events = events[:NUM_REQ]
else:
    # 如果不够，用循环填充
    extra_needed = NUM_REQ - len(events)
    print(f"  Need {extra_needed} more events, generating...", file=sys.stderr)
    while len(events) < NUM_REQ:
        obj_id = rng.integers(0, actual_objects)
        t = len(events)
        events.append((t, int(obj_id)))

print(f"Writing {len(events)} events to file...", file=sys.stderr)
out = open("lrutest_10m.csv", "w", buffering=4*1024*1024)
for idx, (t, obj_id) in enumerate(events):
    out.write(f"{idx},{obj_id},{FIXED_SIZE},-1\n")
    if (idx + 1) % 2_000_000 == 0:
        print(f"  Written {idx+1}/{NUM_REQ}", file=sys.stderr)

out.close()
# 统计唯一对象
unique = len(set(e[1] for e in events))
print(f"Done. total_req={len(events)}, unique_obj={unique}", file=sys.stderr)
