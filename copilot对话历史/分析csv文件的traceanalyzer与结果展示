def read_reuse(file_path):
    # format: distance:count
    dist = []
    cnt = []
    with open(file_path, 'r') as f:
        for line in f:
            if line.startswith('#'): continue
            parts = line.strip().split(':')
            if len(parts) == 2:
                dist.append(int(parts[0]))
                cnt.append(int(parts[1]))
    return np.array(dist), np.array(cnt)

