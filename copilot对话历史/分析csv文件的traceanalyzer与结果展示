echo "v4 script ready"

但这个 v4 版本的问题是：geometric 分布的平均重访间隔=5 步意味着每个对象平均产生 ~2M/500K=很多事件（取决于对象生存周期），总事件数可能远超 10M。不过 geometric(0.2) 的期望值是 5，对象平均产生 10M/500K ~ 20 次重访... 让我估算一下：500K 对象 × 平均 20 次/对象 = 10M events，差不多。

这个方法有一个关键缺陷：geometric 分布的重访间隔是恒定的（不会越来越大），所以这不会产生 recency 偏好——同一个对象无论多久前首次出现，其重访概率都一样。

让我重新设计——真正的 LRU 友好 trace 应该有**递增的重访间隔**（对象兴趣衰退）：

Ran terminal command:  cat << 'PYEOF' > tmp/gen_lrutest_10m_v5.py
"""
LRU 侧重 10M trace v5：递增间隔重访 + 工作集漂移

每个对象首次出现后，以递增间隔重访，模型：
  gap_k = base_gap * k^alpha  (k=1,2,3,...)
这样最近出现的对象下次出现的间隔最短 => LRU 最优

同时保证：
- size 固定（消除 size 影响）
- 对象 frequency 由生存时间决定，不需显式 Zipf
"""
import numpy as np
import sys
import heapq

NUM_REQ = 10_000_000
FIXED_SIZE = 10000
BASE_GAP = 3             # 首次重访基础间隔
GAP_ALPHA = 1.5          # 间隔增长指数: gap = BASE_GAP * k^GAP_ALPHA
NEW_OBJ_INTERVAL = 50    # 平均每 50 步引入一个新对象

rng = np.random.default_rng(42)

print("Generating via priority queue...", file=sys.stderr)

# 优先队列: (next_access_time, obj_id, visit_count)
pq = []
next_obj_id = 0
t_new = 0  # 下一个新对象的到达时间

# 预先安排前几个新对象到达
for _ in range(100):
    gap = max(1, int(rng.exponential(NEW_OBJ_INTERVAL)))
    t_new += gap
    heapq.heappush(pq, (t_new, next_obj_id, 0))
    next_obj_id += 1

out = open("lrutest_10m.csv", "w", buffering=4*1024*1024)

for step in range(NUM_REQ):
    # 确保队列中有足够的未来事件
    while pq[0][0] > step + NUM_REQ // 10 and next_obj_id < 2 * NUM_REQ // NEW_OBJ_INTERVAL:
        gap = max(1, int(rng.exponential(NEW_OBJ_INTERVAL)))
        t_new += gap
        heapq.heappush(pq, (t_new, next_obj_id, 0))
        next_obj_id += 1

    # 弹出最近的事件
    t_event, obj_id, visit_k = heapq.heappop(pq)

    out.write(f"{step},{obj_id},{FIXED_SIZE},-1\n")

    # 安排下次重访（间隔递增）
    visit_k += 1
    next_gap = max(1, int(BASE_GAP * (visit_k ** GAP_ALPHA)))
    next_t = step + next_gap
    if next_t < NUM_REQ:
        heapq.heappush(pq, (next_t, obj_id, visit_k))

    # 随机引入新对象
    if rng.random() < 1.0 / NEW_OBJ_INTERVAL:
        heapq.heappush(pq, (step + 1, next_obj_id, 0))
        next_obj_id += 1

    if (step + 1) % 1_000_000 == 0:
        print(f"  {step+1}/{NUM_REQ} done, unique={next_obj_id}, pq_size={len(pq)}", file=sys.stderr)

out.close()
print(f"Done. total_req={NUM_REQ}, total_unique_obj={next_obj_id}", file=sys.stderr)
PYEOF
echo "v5 script ready"

