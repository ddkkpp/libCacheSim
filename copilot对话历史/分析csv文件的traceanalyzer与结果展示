Ran terminal command:  cat << 'PYEOF' > tmp/gen_lrutest_10m.py
"""
生成 LRU 侧重的 10M trace（recency-dominant）

设计原理：
- 对象按"最近访问时间"越新越可能被再访问
- 工作集缓慢漂移（新对象不断引入，旧对象逐渐冷却）
- 所有对象 size 相同（消除 size 影响）
- 所有对象 frequency 差异小（消除 frequency 影响）
- 重访间隔短且与 recency 强相关：最近访问过的对象重访概率最高

具体实现：
- 维护一个活跃窗口(最近 N 个不同对象)
- 每次请求以高概率(0.95)从窗口中按 recency 指数衰减选取
- 以低概率(0.05)引入新对象（工作集漂移）
- 对象 size 固定 10000 bytes
- 时间以 1 秒/请求递增
"""
import random
import sys

NUM_REQ = 10_000_000
WINDOW_SIZE = 5000       # 活跃窗口大小
REACCESS_PROB = 0.95     # 重访概率
FIXED_SIZE = 10000       # 固定 size，消除 size 影响
DECAY = 0.002            # 指数衰减率：越近的对象概率越高

random.seed(42)
next_obj_id = 0
window = []  # 最近访问的对象列表（最新在末尾）

out = open("lrutest_10m.csv", "w")
for t in range(NUM_REQ):
    if not window or random.random() > REACCESS_PROB:
        # 引入新对象
        obj_id = next_obj_id
        next_obj_id += 1
    else:
        # 从窗口中按 recency 指数衰减选取
        # 窗口末尾 = 最近访问，概率最高
        n = len(window)
        weights = [DECAY * (1 - DECAY) ** i for i in range(n)]
        # weights[0] 对应 window[-1]（最近）
        # 归一化
        total = sum(weights)
        r = random.random() * total
        cumsum = 0
        idx = 0
        for i, w in enumerate(weights):
            cumsum += w
            if cumsum >= r:
                idx = i
                break
        obj_id = window[-(idx + 1)]

    out.write(f"{t},{obj_id},{FIXED_SIZE},-1\n")

    # 更新窗口：将 obj 移到末尾（最近位置）
    if obj_id in window:
        window.remove(obj_id)
    window.append(obj_id)
    # 限制窗口大小
    if len(window) > WINDOW_SIZE:
        window.pop(0)

    if (t + 1) % 1_000_000 == 0:
        print(f"  {t + 1}/{NUM_REQ} done, unique_objs_so_far={next_obj_id}", file=sys.stderr)

out.close()
print(f"Done. total_req={NUM_REQ}, total_unique_obj={next_obj_id}", file=sys.stderr)
