> #!/usr/bin/env python3
> """
> 生成 frequency-dominant 合成 trace（CSV: time,obj-id,obj-size,ttl）
>
> 设计思路：
>   - 稳定频率分布：热点组 + 冷尾组，均为 i.i.d. 采样
>   - 热点组对象较少但承载绝大部分请求，且组内按 Zipf 分布
>   - 冷尾组对象很多但总请求占比较低
>   - 固定 size=10000（消除 size 信号）
>   - 无时间局部性（i.i.d.），重点突出 frequency 信号
>
> CLI: gen_lfu_trace.py [output] [hot_objects] [hot_prob] [zipf_alpha]
> """
>
> import sys
> import numpy as np
>
> N_REQUESTS = 10_000_000
> N_OBJECTS = 100_000
> OBJ_SIZE = 10_000
> SEED = 42
> BATCH = 1_000_000
>
> # 支持命令行参数（sweep 时使用）
> OUTPUT         = sys.argv[1] if len(sys.argv) > 1 else "lfutest2_10m.csv"
> HOT_OBJECTS    = int(sys.argv[2])   if len(sys.argv) > 2 else 50_000
> HOT_PROB       = float(sys.argv[3]) if len(sys.argv) > 3 else 0.97
> ZIPF_ALPHA_HOT = float(sys.argv[4]) if len(sys.argv) > 4 else 1.1
>
>
> def zipf_pmf(n, alpha):
>     """计算 Zipf PMF: P(k) = 1/k^alpha / H_n"""
>     ranks = np.arange(1, n + 1, dtype=np.float64)
>     weights = 1.0 / np.power(ranks, alpha)
>     weights /= weights.sum()
>     return weights
>
>
> def main():
>     rng = np.random.RandomState(SEED)
>     hot_pmf = zipf_pmf(HOT_OBJECTS, ZIPF_ALPHA_HOT)
>
>     print(
>         f"hot_objects={HOT_OBJECTS}, hot_prob={HOT_PROB}, "
>         f"zipf_alpha_hot={ZIPF_ALPHA_HOT}, top1_in_hot={hot_pmf[0]*100:.1f}%",
>         flush=True
>     )
>
>     with open(OUTPUT, "wb") as f:
>         for batch_start in range(0, N_REQUESTS, BATCH):
>             bs = min(BATCH, N_REQUESTS - batch_start)
>             is_hot = rng.random(bs) < HOT_PROB
>             hot_n = int(is_hot.sum())
>             cold_n = bs - hot_n
>
>             obj_ids = np.empty(bs, dtype=np.int32)
>             if hot_n > 0:
>                 obj_ids[is_hot] = rng.choice(HOT_OBJECTS, size=hot_n, p=hot_pmf)
>             if cold_n > 0:
>                 obj_ids[~is_hot] = rng.randint(HOT_OBJECTS, N_OBJECTS, size=cold_n)
>
>             times = np.arange(batch_start + 1, batch_start + bs + 1)
>             sizes = np.full(bs, OBJ_SIZE, dtype=np.int32)
>             zeros = np.zeros(bs, dtype=np.int32)
>             data = np.column_stack([times, obj_ids, sizes, zeros])
>             lines = [f"{r[0]},{r[1]},{r[2]},{r[3]}\n" for r in data]
>             f.write("".join(lines).encode())
>
>     print(f"Done: {OUTPUT}", flush=True)
>
>
> if __name__ == "__main__":
>     main()
> PYEOF
