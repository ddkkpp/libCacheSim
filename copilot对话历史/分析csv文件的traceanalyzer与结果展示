```c
void pqueue_change_priority(pqueue_t *q, pqueue_pri_t new_pri, void *d) {
    pqueue_pri_t old_pri = q->getpri(d);
    q->setpri(d, new_pri);
    posn = q->getpos(d);
    if (q->cmppri(old_pri, new_pri))   // old_pri < new_pri → 优先级提升
        bubble_up(q, posn);
    else
        percolate_down(q, posn);       // 否则往下沉
}
```

