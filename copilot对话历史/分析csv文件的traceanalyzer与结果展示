Ran terminal command:  cat << 'PYEOF' > tmp/gen_lrutest_10m.py
"""
生成 LRU 侧重的 10M trace（recency-dominant）
LRU 最优 => recency 是驱逐决策唯一有效信号
- 固定 size（消除 size 影响）
- 访问概率仅取决于 recency（上次访问距现在越近越可能再访问）
- frequency 差异小（所有对象长期频率接近）
- 工作集漂移（持续引入新对象）
"""
import random
import sys
from collections import OrderedDict

NUM_REQ = 10_000_000
WINDOW_SIZE = 5000
REACCESS_PROB = 0.95
FIXED_SIZE = 10000
DECAY = 0.002

random.seed(42)
next_obj_id = 0
# OrderedDict: 按插入顺序排列，move_to_end 实现 O(1) recency 更新
window = OrderedDict()

out = open("lrutest_10m.csv", "w")
for t in range(NUM_REQ):
    if not window or random.random() > REACCESS_PROB:
        obj_id = next_obj_id
        next_obj_id += 1
    else:
        # 按 recency 指数衰减采样：最近的在 list 末尾
        keys = list(window.keys())
        n = len(keys)
        # 预计算 CDF 用 random.choices 加速
        weights = [(1 - DECAY) ** i for i in range(n)]
        # weights[0] 对应 keys[-1]（最近）
        chosen_idx = random.choices(range(n), weights=weights, k=1)[0]
        obj_id = keys[-(chosen_idx + 1)]

    out.write(f"{t},{obj_id},{FIXED_SIZE},-1\n")

    if obj_id in window:
        window.move_to_end(obj_id)
    else:
        window[obj_id] = True
    if len(window) > WINDOW_SIZE:
        window.popitem(last=False)

    if (t + 1) % 1_000_000 == 0:
        print(f"  {t+1}/{NUM_REQ} done, unique={next_obj_id}", file=sys.stderr)

out.close()
print(f"Done. total_req={NUM_REQ}, total_unique_obj={next_obj_id}", file=sys.stderr)
